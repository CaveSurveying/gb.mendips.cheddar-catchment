encoding  utf-8
source TopDig.th
# Change name to the main therion file


#Surveys to output
#-----------------


export map -proj plan -layout local -o TopDig.pdf
#Produces plan of cave, on a single sheet

export model -fmt survex -o TopDigth.3d
#Survex file showing centre line only

#export map -proj plan -fmt kml -layout googlemaps -o TopDig.kml

#export model -o TopDig.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o TopDig_Walls.3d
#Survex file showing walls only

layout local
copy common
debug off
map-header 0 0 off

base-scale 1 500
scale 1 1000
endlayout

input ../../common_layout.thsource TopDig.th
