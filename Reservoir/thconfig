encoding  utf-8
source Reservoir.th
# Change name to the main therion file

#Surveys to output
#-----------------


export map -proj plan -layout local -o Reservoir.pdf
#Produces plan of cave, on a single sheet

export model -fmt survex -o Reservoirth.3d
#Survex file showing centre line only

#export model  -o Reservoir.lox
#3d therion model to be viewed in the therion viewer

#export model  -fmt dxf -o Reservoir.dxf
#export model  -fmt esri -o Reservoir.esr

#export map -proj plan -o Reservoir_Walls.3d
#Survex file showing walls only

layout local
copy common
debug off
map-header 0 0 ne
#scale-bar 50 m
rotate -90
symbol-hide group cave-centreline
endlayout

input ../common_layout.th
