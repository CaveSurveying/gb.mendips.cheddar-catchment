encoding  utf-8
survey Reservoir


input Ascension/Ascension.th
input BrokenFinger/BrokenFinger.th
input CeiledUp/CeiledUp.th
input CeilingAround/CeilingAround.th
input CeilingAround2/CeilingAround2.th
input CeilingLine/CeilingLine.th
input ChGorge/ChGorge.th
input Deeper/Deeper.th
input DingleyDell/DingleyDell.th
input FrozenDeep/FrozenDeep.th
input GreatExpectations/GreatExpectations.th
input Golgotha/Golgotha.th
input HerbertsAttic/HerbertsAttic.th
input HappySnappers/HappySnappers.th
input JillsSlither/JillsSlither.th
input SouthPassage/SouthPassage.th
input ResEnt/ResEnt.th
input PottersHeaven/PottersHeaven.th
input PulsationAven/PulsationAven.th
input PulsationAven2/PulsationAven2.th
#input R1/R1.th
#input R2/R2.th
#equate Q@R1 Q@R2
#input R3/R3.th
#equate Q@R1 Q@R3
#removed as passage has been backfilled
#input R4/R4.th
#equate 426@R2 426@R4
#input R5/R5.th
#equate 459@R4 459@R5
#input R6/R6.th
#equate 464@R5 464@R6 
#input R7/R7.th
#equate 471@R6 471@R7
#input R8/R8.th
#equate 486@R7 486@R8
#input R9/R9.th
#equate 488@R8 488@R9
#input R10/R10.th
#equate 481@R7 481@R10
#input R11/R11.th
#equate 512@R10 512@R11
#input R12/R12.th
#equate 534@R11 534@R12
#input R13/R13.th
#equate 553@R12 553@R13
input SideRift/SideRift.th
input Skyfall/Skyfall.th
input Sleeper/Sleeper.th
input TopDig/TopDig.th
input ToHole/ToHole.th
input ToplessAven/ToplessAven.th
input ToplessClimb/ToplessClimb.th
input UnderGorge/UnderGorge.th
input Vertigo/Vertigo.th
input WISh/WISh.th
input WIShICouldFly/WIShICouldFly.th
#Connection to the therionised data
#equate 471@R6 1.0@TopDig

equate 1.6@ChGorge 1.0@ToHole

equate 1.0@Ascension 1.6@UnderGorge
equate 1.27@Ascension 1.7@Vertigo
equate 1.35@Ascension 5.15@FrozenDeep
equate 3.0@BrokenFinger 2.5@CeilingAround
equate 1.8@CeiledUp 1.1@CeilingAround2
equate 2.0@CeilingAround 1.25@CeilingAround2
equate 1.20@CeilingAround2 19.6@CeilingLine 
equate 2.21@CeilingAround 1.0@Vertigo
equate 19.0@CeilingLine 5.7@FrozenDeep
equate 11.0@Deeper 5.12@FrozenDeep
equate 11.23@Deeper  12.0@DingleyDell
equate 13.0@ToplessClimb 4.21@TopDig 
equate 4.21@TopDig 1.0@ToplessAven
equate 5.0@FrozenDeep 1.36@GreatExpectations
equate 5.14@FrozenDeep 16.0@Skyfall
equate 5.0@FrozenDeep 17.0@WISh
equate 5.4@FrozenDeep 17.12@WISh
equate 9.0@HerbertsAttic 3.22@Golgotha
equate 7.8@PulsationAven 10.0@JillsSlither
equate 7.0@PulsationAven 4.13@TopDig
equate 7.8@PulsationAven 8.0@PottersHeaven
equate 7.2@PulsationAven 14.0@PulsationAven2
equate 1.15@ToplessAven 1.15@GreatExpectations
equate 1.3@ToplessAven 3.0@Golgotha
equate 1.0@TopDig 1.14@Sleeper
equate 1.12@TopDig 1.0@HappySnappers
equate 1.11@ResEnt 8.0@SouthPassage
equate 1.0@Sleeper 1.26@ResEnt
equate 1.7@Sleeper 2.0@SideRift
equate 1.0@ResEnt 1.0@ChGorge
equate 1.10@WIShICouldFly 17.0@WISh

centreline
data nosurvey from to
flags duplicate
1.5@WIShICouldFly 5.3@FrozenDeep
flags not duplicate
endcentreline


#Plan joins
##########################################
join AscensionSP1@Ascension CeilingAroundSP1@CeilingAround -smooth on
join AscensionSP1@Ascension VertigoSP1@Vertigo -smooth on
join AscensionSP1@Ascension UnderGorgeSP1@UnderGorge -smooth on
join CeilingAroundSP2@CeilingAround CeilingAround2SP1@CeilingAround2 -smooth on
join CeilingAroundSP1@CeilingAround VertigoSP1@Vertigo -smooth on
join DeeperSP1@Deeper FrozenDeepSPl1@FrozenDeep -smooth on
join DeeperSP2@Deeper DingleyDellSP1@DingleyDell -smooth on
join FrozenDeepSPl1@FrozenDeep GreatExpectationsSPl2@GreatExpectations  -smooth on
join FrozenDeepSPl1@FrozenDeep SkyfallSP1@Skyfall  -smooth on
join GreatExpectationsSPl1@GreatExpectations ToplessAvenSPl1@ToplessAven -smooth on
join GolgothaSPl4@Golgotha ToplessAvenSPl1@ToplessAven -smooth on
join HappySnappersSPl1@HappySnappers TopDigSPl1@TopDig -smooth on
join JillsSlitherSPl1@JillsSlither PottersHeavenSPl1@PottersHeaven -smooth on
join JillsSlitherSPl1@JillsSlither PulsationAvenSPl1@PulsationAven -smooth on
join PulsationAvenSPl1@PulsationAven PulsationAven2SP1@PulsationAven2  -smooth on
join PulsationAvenSPl1@PulsationAven TopDigSPl1@TopDig  -smooth on
join ResEntSPl1@ResEnt SouthPassageSPl1@SouthPassage -smooth on
join SleeperSPl3@Sleeper TopDigSPl1@TopDig -smooth on
join SleeperSPl3@Sleeper SideRiftSPl1@SideRift -smooth on
join TopDigSPl1@TopDig ToplessAvenSPl1@ToplessAven -smooth on
join right1@TopDig:join wall1@ToplessClimb:0 -smooth on
join left1@TopDig:join wall1@ToplessClimb:end -smooth on

#Projected Elevation joins (E90)
##########################################

join AscensionSE90_1@Ascension UnderGorgeSE90_3@UnderGorge -smooth on
join AscensionSE90_1@Ascension VertigoSE90_1@Vertigo #-smooth on
join AscensionSE90_1@Ascension CeilingAroundSE90_1@CeilingAround -smooth on
join CeiledUpSE90_1@CeiledUp CeilingAround2SE90_6@CeilingAround2 -smooth on
join CeilingAroundSE90_1@CeilingAround CeilingAround2SE90_1@CeilingAround2 -smooth on
join CeilingAroundSE90_2@CeilingAround CeilingAround2SE90_2@CeilingAround2 -smooth on
join CeilingAround2SE90_6@CeilingAround2 CeiledUpSE90_1@CeiledUp -smooth on -count 2
join CeilingAround2SE90_6@CeilingAround2 FrozenDeepSE90_1@FrozenDeep -smooth on
join CeilingAroundSE90_1@CeilingAround VertigoSE90_1@Vertigo -smooth on
join DeeperSE90_2@Deeper FrozenDeepSE90_1@FrozenDeep -smooth on
join FrozenDeepSE90_1@FrozenDeep GreatExpectationsSE90_1@GreatExpectations -smooth on
join FrozenDeepSE90_1@FrozenDeep WIShICouldFlySE90_1@WIShICouldFly -smooth on
join SkyfallPath@FrozenDeep:0 floor1@Skyfall -smooth on
join GolgothaSE90_1@Golgotha HerbertsAtticSE90_1@HerbertsAttic -smooth on
join GolgothaSE90_1@Golgotha ToplessAvenSE90_1@ToplessAven -smooth on
join GreatExpectationsSE90_1@GreatExpectations WIShICouldFlySE90_1@WIShICouldFly  -smooth on
join GreatExpectationsSE90_1@GreatExpectations ToplessAvenSE90_1@ToplessAven -smooth on
join HappySnappersSE90_1@HappySnappers  TopDigSE90_1@TopDig -smooth on
join JillsSlitherSE90_1@JillsSlither PottersHeavenSE90_1@PottersHeaven
join JillsSlitherSE90_1@JillsSlither PulsationAvenSE90_1@PulsationAven -smooth on
join PulsationAvenSE90_1@PulsationAven PulsationAven2SE90_1@PulsationAven2 -smooth on -count 2
join PulsationAvenSE90_1@PulsationAven TopDigSE90_1@TopDig -smooth on 
join ResEntSE90_2@ResEnt SouthPassageSE90_1@SouthPassage -smooth on
join ResEntSE90_3@ResEnt SleeperSE90_1@Sleeper -smooth on
join SideRiftSE90_1@SideRift SleeperSE90_1@Sleeper -smooth on -count 2
join SleeperSE90_1@Sleeper  TopDigSE90_3@TopDig -smooth on
join  ToplessClimbSE90_1@ToplessClimb TopDigSE90_1@TopDig -smooth on 
join  TopDigSE90_1@TopDig ToplessAvenSE90_1@ToplessAven -smooth on


map FrozenDeepSplaysM -proj plan
  FrozenDeep
  FrozenDeepM@FrozenDeep
endmap

map ReservoirM -title "Reservoir Hole" -proj plan
  VertigoM@Vertigo
  CeiledUpM@CeiledUp
  CeilingAround2M@CeilingAround2
  CeilingAroundM@CeilingAround
  BrokenFingerM@BrokenFinger
  AscensionM@Ascension
  UnderGorgeM@UnderGorge
  SkyfallM@Skyfall
  FrozenDeep
  HerbertsAtticM@HerbertsAttic
  GolgothaM@Golgotha
  GreatExpectationsM@GreatExpectations
  FrozenDeepM@FrozenDeep
  HappySnappersM@HappySnappers
  JillsSlitherM@JillsSlither
 break
  PulsationAven2M@PulsationAven2
  PulsationAvenM@PulsationAven
 break
  PottersHeavenM@PottersHeaven
  ResEntM@ResEnt
  SideRiftM@SideRift
  SleeperM@Sleeper
  SouthPassageM@SouthPassage
  TopDigM@TopDig
  ToplessAvenM@ToplessAven
  DeeperM@Deeper
  DingleyDellM@DingleyDell
  WIShM@WISh
  WIShICouldFlyM@WIShICouldFly
#  R1@R1
#  R2@R2
#  R3@R3
#  R4@R4  
#  R5@R5
#  R6@R6
#  R7@R7
#  R8@R8
#  R9@R9
#  R10@R10
#  R11@R11
#  R12@R12
#  R13@R13
#  survex_format
endmap

map ReservoirME90 -proj [elevation 90]
  AscensionME90@Ascension
  SkyfallME90@Skyfall
  VertigoME90@Vertigo
  CeilingAroundME90@CeilingAround
 break
  CeilingAround2ME90@CeilingAround2
  CeiledUpME90@CeiledUp
  UnderGorgeME90@UnderGorge
  GreatExpectationsME90@GreatExpectations
  HerbertsAtticME90@HerbertsAttic
  GolgothaME90@Golgotha
  ResEntME90@ResEnt
  SouthPassageME90@SouthPassage
  SleeperME90@Sleeper
  SideRiftME90@SideRift
  JillsSlitherME90@JillsSlither
  PottersHeavenME90@PottersHeaven
  PulsationAvenME90@PulsationAven
  PulsationAven2ME90@PulsationAven2
  ToplessClimbME90@ToplessClimb
  ToplessAvenME90@ToplessAven
  TopDigME90@TopDig
  HappySnappersME90@HappySnappers
  FrozenDeepME90@FrozenDeep
  DeeperME90@Deeper
  DingleyDellME90@DingleyDell
  WIShICouldFlyME90@WIShICouldFly
endmap

endsurvey

