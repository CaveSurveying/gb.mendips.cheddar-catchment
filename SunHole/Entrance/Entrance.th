encoding  utf-8
survey Entrance -namespace off

input Entrance.th2
input EntranceE45.th2
input EntranceEe.th2

map EntranceM
  EntranceSP1
 break
  EntranceSP2
endmap

map EntranceE45M -proj [elevation 45]
  EntranceSE45_1
endmap

map EntranceEeM -proj extended
  EntranceSE1
endmap  
  
centreline
