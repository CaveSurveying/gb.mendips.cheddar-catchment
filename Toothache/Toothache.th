encoding  utf-8
survey Toothache

centreline
cs OSGB:ST
#Fudge Survey by GJM to show cave on output.
date 2010

data normal from to tape compass clino ignoreall
Toothache  2  20  -  down
#depth reported as 20 m by diggers March 2012.

station Toothache "" entrance
fix Toothache  48580 55370 213

#import Toothache.3d -surveys use -filter toothache -cs EPSG:27700 -calibrate [0 0 0 299912 99991 0]
#Should be -calibrate [0 0 0 300000 100000 0]
#bodge to compensate for not doing datum shift between
#Airy and WGS84 ellipsoids

endcentreline
endsurvey

