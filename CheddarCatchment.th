encoding  utf-8
survey CheddarCatchment -title "Cheddar Catchment"

map CheddarMinorM -title "Other Caves"
  EntranceM@Entrance.BakeHole
  EntranceM@Entrance.BridgedRiftCave
  EntranceM@Entrance.PrideEvans
  EntranceM@Entrance.PrideEvansAttic
  EntranceM@Entrance.SunHole
  EntranceM@Entrance.YewCleftHole
  WhitebeamM@Whitebeam.WhitebeamArea
  SwineHoleM@SwineHole.WhitebeamArea
  BrockM@Brock.WhitebeamArea
  CoopersM@Coopers
  EntranceM@CanyonCave
  SayesM@Sayes
endmap

#to process this the correct 3d files are needed 
#in the correct directories
input Attborough/Attborough.th
input Bagpit/Bagpit.th
input BakeHole/BakeHole.th
input Blackmoor/Blackmoor.th
input BlackrockRift/BlackrockRift.th
input BoneHole/BoneHole.th
input BoweryCorner/BoweryCorner.th
input Box/Box.th
input BoxCave/BoxCave.th
input BridgedRiftCave/BridgedRiftCave.th
input CanyonCave/CanyonCave.th
input Champions/Champions.th
input Charterhouse/Charterhouse.th
input CharterhouseWarren/CharterhouseWarren.th
input ChelmsCombe/ChelmsCombe.th
input ChewtonMendip/Buddles.th
input Coopers/Coopers.th
input Coxs/Coxs.th
#corners is only needed for google maps mendip map
#input corners.th
input GB/GB.th
input Goughs/Goughs.th
input GoughsOld/GoughsOld.th
input Grebe/Grebe.th
input GreatOones/GreatOones/GreatOones.th

#input Great_Oones/Great_Oones.th
#input "Great Swallet/Great_Swallet.th" 
#input Largesurface/Largesurface.th

#input Long_Hole/Long_Hole.th
input LongHole/LongHole.th
input Longwood/Longwood.th 
input LongwoodValleySink/LongwoodValleySink.th
input ManorFarm/ManorFarm.th 

#files containing other entrances
input Other_Sites/Cheddar.th
input Other_Sites/Other.th
input Other_Sites/UF_Area.th

input Palmers/Palmers.th
input Pigs/Pigs.th
input PrideEvans/PrideEvans.th
input PrideEvansAttic/PrideEvansAttic.th
#input Reads/Reads.th
#replace old read with 2010 version
input ReadsGrotto/ReadsGrotto.th
input Reynolds/Reynolds.th
input Reservoir/Reservoir.th
#replaced Willie's Rhinorift survey with Phil's which has more cave included
input RRift/RRift.th
input SayesHole/Sayes/Sayes.th
input SparryFissure/SparryFissure.th
input Spider/Spider.th
input SunHole/SunHole.th
# input Surface/Surface.th  # Surfaace directory has disappeared...
input Hangover/Hangover.th
input Timber/Timber.th
input Toothache/Toothache.th
input Totty/Totty.th
input TyningsGS/TyningsGS.th
input TyningsBarrow/TyningsBarrow.th
