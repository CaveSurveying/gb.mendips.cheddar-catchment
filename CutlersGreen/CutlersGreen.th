encoding  utf-8
survey CutlersGreen -title "Cutler's Green"

input MinorHoles/MinorHoles.th
input MainHole/MainHole.th
input 2020/2020.th

map CutlersGreenM
  MainHoleM@MainHole
  MinorHolesM@MinorHoles
endmap

map CutlersGreenME90
  MainHoleME90@MainHole
  MinorHolesME90@MinorHoles
endmap

map CutlersGreenME180
  MainHoleME180@MainHole
  MinorHolesME180@MinorHoles
endmap

equate 1.0@MinorHoles 0@MainHole
equate 35@MainHole 1@CutlersGreen2020

endsurvey

