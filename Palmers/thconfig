encoding  utf-8
source Palmers.th
# Change name to the main therion file


#Surveys to output
#-----------------

export map -proj plan -layout local -o Palmers.pdf
#Produces plan of cave, on a single sheet

export map -proj extended -layout local -o PalmersEe.pdf

export model -fmt survex -o Palmersth.3d
#Survex file showing centre line only

#export model -o Palmers.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o Palmers_Walls.3d
#Survex file showing walls only

layout local
copy common
debug off
map-header 10 10 ne
map-comment "Drawn in Therion by Andrew Atkinson<br>Creative Commons BY NC SA" 
#colour map-bg 90 
scale 1 150
scale-bar 10 m
symbol-hide group cave-centreline
endlayout

#input ../common_layout.th
