encoding  utf-8
language en_UK
source BoneHole.th
select HappyNewYearMap@BoneHole
select BoneHoleMapE98@BoneHole
#unselect BH_PerforationChoke.BoneHole
#select 01_BoneSlope2015.BoneHole
#select 02_LadderPitch.BoneHole
#select BH_PerforationChoke.BoneHole
#select BH_Surface.BoneHole
#select BH_Entrance.BoneHole
#select BH_FirstPitch.BoneHole
#select Bone2.BoneHole
#select Bone3.BoneHole
#select LadderLink@HappyNewYear.BoneHole
#select HappyNewYear1@HappyNewYear.BoneHole

layout lcommon
	scale-bar 10 m
        color map-fg altitude #50  
 	scale 1 200
endlayout 

export model -format survex -o Maps/BoneHole.3d
#export model -format loch -o Maps/BoneHole.lox
export map -projection plan -layout lcommon -o Maps/BoneHole.pdf
export map -projection [elevation 98] -layout lcommon -o Maps/BoneHole_el90.pdf
#export map -projection extended -layout lcommon -o Maps/BoneHole_ex98.pdf
#export map -projection plan -format xvi -layout lcommon -o Maps/BoneHole.xvi
#export map -projection extended -format xvi -layout lcommon -o Maps/BoneHole_ex.xvi
#export map -projection elevation -format xvi -layout lcommon -o Maps/BoneHole_el.xvi
#export atlas -projection plan -layout lcommon -o Maps/BoneHole.pdf
