encoding  utf-8
survey BoneDig2

input BoneDig2.th2
input BoneDig2Ee.th2
input BoneDig2E90.th2

map BoneDig2M
  BoneDig2SP1
 break
  BoneDig2SP2
 break
  BoneDig2SP3
 break
  BoneDig2SP4
endmap

map BoneDig2ME
  BoneDig2SE1
