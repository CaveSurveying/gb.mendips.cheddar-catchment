survey HappyNewYear

	input HappyNewYear1.th
	input LadderLink.th
	input HappyNewYear2.th
	input HappyNewYear3.th
	input HappyNewYear4.th

	equate 3.11@HappyNewYear1	3.11@HappyNewYear2
	equate 4.3@HappyNewYear1	4.3@LadderLink
	equate 3.16@HappyNewYear2	3.16@HappyNewYear3
	equate 3.19@HappyNewYear3	3.19@HappyNewYear4
	
	#Close loop
	equate 3.34@HappyNewYear3	3.39@HappyNewYear4
	
	input HappyNewYear1.th2
	input LadderLink.th2
	input HappyNewYear2.th2
	input HappyNewYear3.th2
	input HappyNewYear4.th2
	input HappyNewYear4SP2.th2
	
	input HappyNewYear1E98.th2
	input HappyNewYear3E98.th2
	
	input HappyNewYear1E278.th2
	input HappyNewYear3E278.th2
	
	map HappyNewYearM1
		HappyNewYear1SP1
		break
		LadderLinkSP1
	endmap
	map HappyNewYearM2
		HappyNewYear4SP1
		break
		HappyNewYear4SP2
		break
		HappyNewYear3SP1
		break
		HappyNewYear2SP1
	endmap
	
	map HappyNewYearME98
		HappyNewYear1SE98_1
		HappyNewYear1SE98_2
		HappyNewYear1SE98_3
		HappyNewYear3SE98_1
		HappyNewYear3SE98_2
	endmap

	map HappyNewYearME278
		HappyNewYear3SE278_2
		break
		HappyNewYear1SE278_1
		HappyNewYear1SE278_2
		HappyNewYear1SE278_3
		HappyNewYear3SE278_1
	endmap

endsurvey