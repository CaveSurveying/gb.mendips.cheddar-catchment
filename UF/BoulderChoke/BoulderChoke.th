encoding  utf-8
survey BoulderChoke -title "Bouder Choke"

  centreline -extend right
    #explo-team ""
    #explo-team ""
    #explo-date 2006.mm.dd
    
    units clino compass degree
    units length meter
    
    date 2007.08.03
    team "Ben Cooper"    instruments  # Instruments
    team "Mike Richardson"  notes    # Mater note taker
    instrument length  "Ben's Bosch DLE50 laser rangefinder"
    instrument compass  "Phil Underwood's SAP"  
    instrument clino  "Phil Underwood's SAP"
    
    #declination -2.977 deg  	# BGS at 2007.08.03 (2007.675) 51.2987N 2.71038W
    #declination -2.990 deg  	# BGS at 2007.08.03 51.2987N 2.71038W 0.2km.  2010 Model.  Updated Nov 2011
