encoding  utf-8
survey GoldenChamber -title "Golden Chamber"

  centreline
    team "Tim Francis"
    team "Charlie Alison"
    date 2006.11.04

    units clino compass degree
    units length meter
    sd compass 0.5 degrees
    sd clino 0.3 degrees
    copyright 2007 "Mendip Caving Group"

    instrument tape Tim's # 15m so no need for an adjustment
    
    #declination -3.089 deg  	# BGS at 2006.11.04 (2006.93) 51.2987N 2.71038W  2010 model is -3.103
  				# http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
    declination -2.550 deg    	# Allign to grid, Grid North +0.5535 deg

    data normal from to length compass clino 
    # RA2 is on the wall face just as you pop out of the canal. i.e. facing the crawl down towards the Red Room
    rr1  RA1  5.70  331  1   # RA1 is on the mud bank (looking upstream) rather than in the middle of the passage
    RA1  RA2  7.90  004  2
endcentreline
centreline
    # rr1 is centre passage where the stream turns RH off the crawl into Red Room
    team "Tim Francis"
    team "Julie Hesketh"
    date 2006.10.14

    #declination -3.112 deg  	# BGS at 2006.10.14 51.2987N 2.71038W 0.2km Alt 2010 model 
  				# http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
    declination -2.559 deg    	# Allign to grid, Grid North +0.5535 deg

    data normal from to length compass clino 
    rr1  rr2  8.71  167  +2   # I rechecked RR1 - RR2. We got c. 880 compared to the previous 871, confirming 871.
    #rr2 rr2s  4.95  257  0  # RR2 is the point opposite where the stream sinks
    #rr2  rr3  3.55  210  -15  
    #rr3  rr4  4.46  186  -7
    #rr4  rr5  1.97  254  -25
    #rr5  rr6  3.70  224  +28

endcentreline
centreline
    team "Ben Cooper"
    team "Mike Richardson"
    team "Sonya Cotter"
    # Ben instruments; Mike notes; Sonya dolly
    date 2007.02.21
    # laser DLE50; Ben's compass and Clino
    walls on

    #declination -3.058 deg  	# BGS at 2007.02.21 51.2987N 2.71038W 0.2km Alt 2010 model 
  				# http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
    declination -2.505 deg    	# Allign to grid, Grid North +0.5535 deg

    equate rr2 r4 #?  approx, because we don't know exactly where r4 was, and sadly did not mark rr2 either.

    data normal from  to  length compass  clino  left  right  up  down
    #r2	r1	1.4	280	0
    r1a r1	0.01	100	0	0.1	0.1	0.1	0.1	# 1 Stream exits	
    r1	r2	1.4	100	0	0.6	0.3	1.0	0	# 2 Stone in stream	
    #r3	r2	2.74	240	-44
    r2	r3	2.74	060	+44	1.0	0.4	0.6	0.2	# 3 On boulder on slope
    r3	r4	4.32	073	+28	4.0	3.7	0.7	0	# 4 On boulder by acro prop
    r4	r5	6.23	201	-16.5	[0 0.8]	[0.6 0.6] 0.9	0	# 5 on floor before drop
    r5	r6	1.33	166	0	0	1.4	0.5	0.5	# 6 LH wall at drop
    #r7	r6	2.53	050	+21
    r6	r7	2.53	230	-21	0.2	0.6	0.4	0	# 7 On floor close to end
    data normal from  to  length compass  clino  
    #r8	r7	2.51	036	-40	
    sd compass 2 degrees
    r7	r8	2.51	216	+40	
    sd compass 0.5 degrees
    data normal from  to  length compass  clino  left  right  up  down
    #r9	r7	0.93	082	-04	
    r7	r9	0.93	262	+04	0.5	0.3	1.0	0.2	# 9 RH wall before drop down
    r9	r10	2.25	274	-33	0.35	0	0.7	1.3	# 10 Obvious nodule on RH wall
    r10	r11	1.36	284	-52	0	0.7	0.8	0.8	# 11 Bulge in LH wall
    r11	r12	0.68	342	-44	2	0.5	1.5	0.3	# 12est Top of boulder in middle of small chamber
    r12	r13	1.98	231	-38	0.3	0.2	0.8	0.3	# 13 Flat boulder close to stream 
    r13	r13a	0.84	240	-10	0.2	0.2	0.6	0.2	#Water enters on right.  Measurement to far wall of inlet.
    r13a r13b	1	330	0	0.1	0.1	0.05	0.2	# Estimate direction for water inlet
    r13	r14	1.50	240	-10	0.1	0.1	0.5	0	# 14 Surface of water at end
    
    equate r8 1
    #equate rr6 1

endcentreline
centreline
    team "Mike Richardson"
    team "Linda Milne"
    date 2006.09.04
    calibrate length 0.095  # missing first 10cm
    
    #declination -3.128 deg  	# BGS at 2006.09.04 51.2987N 2.71038W 0.2km Alt 2010 model 
  				# http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
    declination -2.575 deg    	# Allign to grid, Grid North +0.5535 deg

    walls on
    data normal from  to  compass  clino  length  left  right  up  down
    1  1a	98.5	-6	0.1  	1.2  0.0  0.5  1.0  # 1 Andrews Grotto, Red Room end
    1  2	98.5  	-6  	4.22  	0.0  0.8  0.8  0.5  # 2 Inside B.C in first hole
    2  3  	196  	-8  	2.3  	0.0  0.4  0.4  0.2  # 3 Inside B.C in second hold
    3  4  	228  	-0.5	1.65  	0.6  0.0  1.0  0.6  # 4 Inside B.C bottom of climb
    4  5  	220  	54  	1.6  	0.0  0.4  0.3  0.2  # 5 Half way up wooden support
    5  6  	255  	-4  	1.78 	0.4  0.0  0.2  0.2  # 6 Inside B.C RHS puddle
    6  7  	241  	15  	1.58 	0.0  0.9  0.2  0.2  # 7 End B.C just before shelf
    7  8  	241  	-7.5	4.05 	3.0  2.0  1.0  1.5  # 8 Back wall of Golden Chamber
    8  9  	300  	-35 	3.05 	1.0  0.2  1.4  3.0  # 9 Back wall above climb down
    9  10 	194  	-64 	3.9  	0.5  0.5  2.0  0.0  # 10 Floor at start of rift
    #10  11  	173  	-9  	4.34 	1.0  2.0  2.0  0.0  # 11 Rock on floor just beyond rift
    10  10a  	173  	-9  	0.1 	0.2  0.2  0.5  0.0  # 10a (est. lrud) imaginary point at start of rift
    10a  11a  	173  	-9  	4.14 	0.2  0.2  0.5  0.0  # 11a (est. lrud) imaginary point at end of rift
    11a  11  	173  	-9  	0.1 	1.0  2.0  2.0  0.0  # 11 Rock on floor just beyond rift
    #12  11  	322  	-37 	1.66 	1.5  1.5  1.5  0.5  # 12 Side large standing rock
    11  12  	142  	-37 	1.66 	1.5  1.5  1.5  0.5  # 12 Side large standing rock
    12  13  	113  	-18 	6.62 	1.2  0.0  0.4  0.7  # 13 Shelf on RHS passge  
    #14  13  	290  	-0.5	6.6  	1.3  1.2  0.4  0.8  # 14 End wall of main passage
    13 14  	110  	-0.5	6.6  	1.2  1.3  0.4  0.8  # 14 Reversed

    flags duplicate
		extend left
		14 bc2 	263	-29	1.41	1.5	0.6	0.5	0	# 2 LRUD
		extend right
		bc2 bc3	114	-11	1.58	0.2	0.6	0.7	0.4	# 3

  endcentreline
endsurvey

