encoding  utf-8
survey GoldenChamber -title "Golden Chamber"

   centreline
   
      equate 1.12@StreamwayRegained	14@CC
      equate A1@LeatInlet		1.0@StreamwayRegained
      
      station r4d@CC "Digs into boulder choke" continuation dig attr dig "dig" attr name "RR1"
      station r14@CC "Very small phreatic tube.  Streams sinks"  sink continuation attr name "SplitRock" attr LR "left"
      station A23@LeatInlet "Too tight: streamway seen for 3m" continuation attr Name "L23"
      station B2@LeatInlet "Too tight: see for 3m, hear stream, draught" continuation attr Name "LB2" attr LR "left"
      station A14@LeatInlet "Too tight" continuation attr Name "L14"
      
      #Dummy survey leg for placement of unsurveyed continuation datum
      data normal from to compass tape clino
      1.8@StreamwayRegained L4 276	13.5 0
      
      station L4 "Boulder choke" continuation attr Name "L4" attr LR "left"
      flags not duplicate
   endcentreline

   input UF_GoldenChamber.th
   input StreamwayRegained.th
   input LeatInlet.th

   input GoldenChamber_s1.th2  
   input GoldenChamber_s2.th2  
   input StreamwayRegained_s1_v2.th2
   input LeatInlet_s1_v2.th2
   join StreamwayRegained_s1 LeatInlet_s1
   #join wall_sr2_e1 wall_sr_w1 -smooth on
   #join wall_sr2_e2 wall_sr_e2

   map GoldenChamber_map
       GoldenChamber_s1 
       break
       GoldenChamber_s2 
       StreamwayRegained_s1
       LeatInlet_s1
   endmap

   endsurvey
