encoding  utf-8
survey GoldenChamber -title "Golden Chamber"

  centreline
    units clino compass degree
    units length meter

    #declination -3.089 deg  	# BGS at 2006.11.04 (2006.93) 51.2987N 2.71038W
  				# http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
    declination -2.54 deg    	# Allign to grid, Grid North +0.5535 deg

    # RA2 is on the wall face just as you pop out of the canal. i.e. facing the crawl down towards the Red Room
    team "Tim Francis"
    team "Charlie Alison"
    date 2006.11.04
    data normal from to length compass clino 
    instrument tape Tim's # 15m so no need for an adjustment
    rr1	RA1	5.70	331	1 	# RA1 is on the mud bank (looking upstream) rather than in the middle of the passage
    RA1	RA2	7.90	004	2

    # rr1 is centre passage where the stream turns RH off the crawl into Red Room
    team "Tim Francis"
    team "Julie Hesketh"
    date 2006.10.14
    data normal from to length compass clino 
    rr1	rr2	8.71	167	+2 	# I rechecked RR1 - RR2. We got c. 880 compared to the previous 871, confirming 871.
    rr2 rr2s	4.95	257	0	# RR2 is the point opposite where the stream sinks
    rr2	rr3	3.55	210	-15	
    rr3	rr4	4.46	186	-7
    rr4	rr5	1.97	254	-25
    rr5	rr6	3.70	224	+28
    
    equate rr6 1

    team "Mike Richardson"
    team "Linda Milne"
    date 2006.09.04
    calibrate length 0.095	# missing first 10cm
    
    walls on
    data normal from	to	compass	clino	length	left	right	up	down
		1	1a	98.5	-6	0.01	1.2	0.0	0.5	1.0	# 1 Andrews Grotto, Red Room end
		1	2	98.5	-6	4.22	0.0	0.8	0.8	0.5	# 2 Inside B.C in first hole
		2	3	196	-8	2.3	0.0	0.4	0.4	0.2	# 3 Inside B.C in second hold
		3	4	228	-0.5	1.65	0.6	0.0	1.0	0.6	# 4 Inside B.C bottom of climb
		4	5	220	54	1.6	0.0	0.4	0.3	0.2	# 5 Half way up wooden support
		5	6	255	-4	1.78	0.4	0.0	0.2	0.2	# 6 Inside B.C RHS puddle
		6	7	241	15	1.58	0.0	0.9	0.2	0.2	# 7 End B.C just before shelf
		7	8	241	-7.5	4.05	3.0	2.0	1.0	1.5	# 8 Back wall of Golden Chamber
		8	9	300	-35	3.05	1.0	0.2	1.4	3	# 9 Back wall above climb down
		9	10	194	-64	3.9	0.5	0.5	2	0.0	# 10 Floor at start of rift
		10	11	173	-9	4.34	1	2	2.0	0.0	# 11 Rock on floor just beyond rift
		12	11	322	-37	1.66	1.5	1.5	1.5	0.5	# 12 Side large standing rock
		12	13	113	-18	6.62	1.2	0.0	0.4	0.7	# 13 Shelf on RHS passge	
		14	13	290	-0.5	6.6	1.3	1.2	0.4	0.8	# 14 End wall of main passage

  endcentreline
endsurvey

