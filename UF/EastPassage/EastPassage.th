encoding  utf-8
survey EastPassage -title "East Passage"

  equate E6@CL       14@EP.Pony

  # Let's try to rescue something from the fauly BeyondZebraAcen survey, but equating it to the Tim/Richard survey
  # Take a copy of the Tim/Richard survey from E11 to E32, and call it D11 to D32, and use that
  equate D16@CL       42@BeyondZebraAven.Pony # approx Y-junction
  equate D21@CL       48@BeyondZebraAven.Pony # approx Tube to muddy crawl
  equate D26@CL       54@BeyondZebraAven.Pony # approx Tube sharp bend
  equate D32@CL       70@BeyondZebraAven.Pony # approx Tube sharp bend

  input EastPassageCL.th
  input EastPassagePony.th
  
  input EastPassage_s1.th2
  input EastPassage_s2.th2
  input WaterWorks_s1.th2

  map EastPassage_m1 -title "East Passage"
     EastPassage_s2
     EastPassage_s1
     break
     WaterWorks_s1
  endmap

endsurvey

