encoding  utf-8

survey BZA_Pony # Worsening SAP calibration, reflected in compass SD
    centreline
      units clino compass degree
      units length meter
      instrument length  "Ben's Bosch DLE50 laser rangefinder"
      instrument compass  "Ben's SAP #7"

      team "Ben Cooper"
      team "Mike Richardson"
      date 2008.01.10
      #declination -2.924 deg    # BGS at 2008.06.13 51.2987N -2.71038W 0.2km 2010 Model.  Updated Nov 2011
          # http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
      declination -2.371 deg      # Allign to grid, Grid North +0.5535 deg      
      
      sd length 0.75 centimeter
      sd compass 3 degree
      sd clino 1 degree
      
      flags approx # Poor SAP calibration, reflected in compass SD
      
      data normal \
      from to  length  compass  clino  left  right  up  down    # Start is 41@FullLRUD
      flags duplicate
      20 START  3.76  162  -18  [4.0 3.3] [1.1 0.8] [6.4 0.4] [1.2 0.4]  # 20-START
      flags not duplicate
      mark 20 fixed                # Zebra Aven
      station 20 "BZA20: fixed 5mm hole; rawlplug; brass screw; reflector placed 10/1/2009" attr print "true" attr Code "fixed" attr Name "BZA20"
      20 21  8.96  137  +01  0.9  0.9  8.0  1.5    # 21
      station 21 "Zebra Aven, climbed" continuation attr aven "9" attr name "Zebra Aven" attr climbed "Joel?"
    
      21 22  4.78  148  +02  1.1  0  8.0  1.7    # 22
      22 23  3.35  128  +19  0.7  0  8.8  1.6    # 23
      23 24   5.76  127  +11  0  0.8  5.0  2.9    # 24
      24 25  2.52  124  -17  0.4  0  5.5  2.0    # 25
      25 26   4.42  141  +29  0.8  0.8  4.5  2.9    # 26 on top of flake at y junction
      
      # RH rift (rises up and doubles back to high level tube)
      26 27  1.59  165  +20  0.6  0.4  5.6  0.4    # 27 up into RH rift
      27 28  4.32  126  +42  0.2  0.2  5  2.4    # 28
      28 29   2.61  159  +53  0  0.4  4.2  3.3    # 29
      29 30  1.54  135  +03  0.8  0.4  4.0  0.3    # 30 Rim of Crystal Pool
      30 31  3.2  144  +0  0.3  0.3  4  0.3    # 31 Across Crystal Pool  Est LRUD
      station 31 "Crystal pool (never entered)" continuation attr Name BZA31
      
      #32 29  2.35  135  -29  [0.4 0]  0.7  4.6  5.3    # 32 on roof of side tube.  LRUD relates to rift
      29 32  2.35  315  +29  0  0.7  4.6  5.3    # 32 reversed
      32 33  1.28  238  -22  [0.5 0] [1.2 0.8] [0 0.6] [0.6 0.6]  # 32-33 into side tube
                        # 250Kg rock crashes down below Mike onto surveying box 5m below
      33 34  1.37  303  +22  0.3  0.2  0  0.6    # 34
      34 35  6.6  275  +06  0.3  0.2  0  0    # 35 End of tube.  Diggable.
      station 35 "Mud filled tube. Dig started 2011" continuation dig attr dig "dig" attr Name "MudOut" attr LR "left"
    
      32 36  1.17  314  -26  0  0.5  4  5.8    # 36 on floor of tube for view down rift
      data normal \
      from to  length  compass  clino
      36 27  5.67  333  -73            # close loop with station below

      data normal \
      from to  length  compass  clino  left  right  up  down
      36 37  4.11  078  +11  [0 0] [1.2 1.3] [0.9 0.5] [0.8 0.5]  # 36-37 Across rift to continuation of tube
      37 38  0.8  112  -01  0  1.3  1.5  1.5    # 38 further along LH wall with view down drop
      38 39  7.77  113  -62  0  0.6  6.5  0.8    # 39 at bottom of LH rift
      
      # LH rift
      26 40  5.91  114  -03  0  1.3  1.9  1.0    # 40 Another y junction
      40 39  3.64  134  +04  0  0.6  6.5  0.8    # 39 Loop closure
      39 41  2.38  161  +10  0.2  0.2  6.5  0.8    # 41 Est LRUD

      # Worsening calibration
      sd compass 4 degree
      
      40 42  2.91  067  +12  [2.7 1.3] 0.8  1.5  0.5    # 42 along main route
      42 43  7.78  121  -04  1.1  1.3  0.5  5    # 43 start of low section
      43 44  4.53  124  -03  0  1.3  1.9  0.9    # 44 end of low section
      44 45  3.47  148  -13  1.3  0  9.0  1.1    # 45
      station 45 "Aven: climbed 3/12/2011 Kev Speight to tube continuation" attr Name "AWOL Aven" continuation attr aven "9" attr climbed "Kev Speight 3/12/2011" explored 40
    
      45 46  8.22  148  -34  0  0.9  6.0  1.0    # 46
      46 47  9.88  132  -02  0.1  0.2  1.3  1.3    # 47
      47 48  5.7  133  -04  0.5  0  0.3  1.0    # 48 lip of second side tube
      48 49  5.87  143  -10  0.1  0.1  1  0.5    # 49 into closing down rift
      station 49 "Too narrow rift" continuation attr Name "BZA49"
      
      # First side tube (blind, but diggable)
      flags duplicate
      data normal \
      from to  length  compass  clino
      47a 47  1.67  136  -24            # 47a lip of first side tube
      flags not duplicate
      data normal \
      from to  length  compass  clino  left  right  up  down
      47a 47b  2.21  188  -09  [0.7 0.3] [0.2 0.3] [0.3 0.1] [0 0.1]  # 47a-47b 47b Est LRUD Diggable
      
      # Worsening calibration
      sd compass 5 degree
      
      # Second side tube
      48 50  4.19  245  -07  [0 0] [1.1 1.1] [0.2 0.5] [0.4 0.2]  # 50 lh wall inside tube
      50 51  2.98  218  -06  0.6  0  0.2  0.5    # 51 rh wall
      51 52  3.35  235  -08  0.2  1  0.0  0.3    # 52
      52 53  3.43  271  +0  0.9  0  0.1  0.5    # 53 Very muddy tube
      53 54  2.24  243  -05  0.9  0.8  0  0.4    # 54
      54 55  3.63  165  -15  0.9  0  0.3  0.3    # 55
      55 56  1.46  123  -15  0  0.7  0.3  0.3    # 56
      56 57  1.20  240  -01  [1.1 1] [0 0] [0.3 0.2] [0.3 0.2]  # 57 on very corner before squeeze
      57 58  4.65  254  -01  0  1  0.3  0.3    # 58 lh wall beyond squeeze

      #58 59   5.0  304  +08  0.5  0.5  0  0.3    # 59 into rh side tube
      58 59   5.0  314  +08  0.5  0.5  0  0.3    # 59 added 10 deg est!
      
      58 60  2.62  235  -18  2.0  0  0.7  0    # 60 on RH corner, start of x-rift
      60 61  2.38  172  -14  2.0  0  0.6  0.6    # 61 on RH corner just across x-rift
      #60 61  2.38  192  -14  2.0  0  0.6  0.6    # 61 added 20-deg est.
      mark 61 fixed                # Far East Tube.  Fixed 10/1/2009
      station 61 "BZA61: fixed 5mm hole; rawlplug; brass screw; reflector.  Fixed 10/1/2009"  attr print "true" attr Code "fixed" attr Name "BZA61"
flags duplicate # re-surveyed (Muddy Hell)
      61 62  6.5  182  -08  0.3  1  0  0.3    # 62 SUMP Est LRUD
      station 62 "Very low with muddy sump" continuation dig attr Name "BZA62"
      
      61 63  3.19  107  +07  0.5  0.5  0  0    # 63 Filled tube, Diggable.
      station 63 "Mud filled tube, diggable" continuation dig attr Name "BZA63"
flags not duplicate

      61 64  4.75  007  +06  [0 1] [1.0 0] [4 1.3] [1 1.6]    # 64 on rh wall
      64 65  1.6  260  -09  0.5  0.4  0.4  1.4    # 65 into LH side passgae 
      65 66  6.0  306  +22  0.5  0.5  1  2    # 66 into narrow rift
      station 66 "Narrow rift" continuation dig attr Name "BZA66" attr LR "left"
                        
      64 67  2.78  313  +01  [1 0] [0 0.5] [5 2] [1.6 2]    # 67 Blind aven climbed Ben Cooper on previous trip (Nov 2008)
      station 67 "Blind aven climbed by Ben Cooper" continuation attr aven "5" attr climbed "Nov 2008" attr name "BZA67"
    
      67 68  3.89  343  -07  0  0.3  3  1.4    # 68
      68 69  6.41  001  -04  0.5  0  4  1.0    # 69 on edge of Deep Pool
      69 70  9.3  291  -06  0.5  0.2  4  0.3    # 70 Across water to end, Est LRUD
    endcentreline
endsurvey

