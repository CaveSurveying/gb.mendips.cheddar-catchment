encoding  utf-8

source UpperFlood

layout l2500	# 1:2500 Map
	scale 1 10000
	surface top        # turns on or off surface bit-map
#       colour map-fg altitude
   	colour preview-below [100 0 100]   # greyscale or x y z colour
#  	colour preview-above [100 0 100]   # greyscale or x y z colour
	symbol-hide group cave-centerline
        symbol-colour point entrance [100 0 0]
	map-header 0 5 off  # turns on the map header positioned at (0,0)
	scale-bar 100 m
	map-comment "Copyright Mendip Caving Group 2016"
	grid off # bottom
	grid-size 100 100 100 m # x,y,z
	#debug on
endlayout



#select Map_m500@UpperFlood
select Outline_m2500@UpperFlood
#select Map_Overlay@UpperFlood
#select EastPassage@UpperFlood
#select 6inGBS@UpperFlood
#select Geo_Surface@UpperFlood
export map -projection plan -layout l2500 -o 0.Maps/UF_2500_surface.pdf
