encoding  utf-8

source UpperFlood

layout l1	# 1:2500 Map
         # scale 1 2500
	scale 1 500
	 #page-setup 21 29.7 28.7 20 0.5 0.5 cm
	overlap 1 cm       # margin sizem default 1cm
	surface bottom # turns on or off surface bit-map
        colour map-fg [100 0 100]
   	colour preview-below [100 0 100] # 100 0 53   # greyscale or x y z colour
   	colour preview-above [100 0 100] # 100 0 53   # greyscale or x y z colour
	map-header 0 5 sw  # turns on the map header positioned at (0,0)
	scale-bar 100 m
	opacity 50
	#statistics topo-length on # per surveyor lengths
	statistics topo off # turns off list of surveyors
	map-comment "Copyright Mendip Caving Group 2007"
	#legend on         # turns on the symbol legend
    	#legend-width 10 cm # printed size, based on scale
	grid bottom
	grid-size 100 100 100 m # x,y,z
	#debug on
	code metapost
#        	fonts_setup(10,15,20,25,50);
		fonts_setup(10,15,30,60,75); 
endlayout

layout l500	# 1:500 Map
        color map-fg [ 100 100 0 ]  
	scale 1 500
	overlap 1 cm       # margin sizem default 1cm
	surface bottom        # turns on or off surface bit-map
	transparency on
	opacity 100
	surface-opacity 100
	map-header 63 65 nw  # turns on the map header positioned at (0,0)
	scale-bar 100 m
	#statistics carto all 
	#debug all
	statistics topo-length on # per surveyor lengths
	#statistics topo off # turns off list of surveyors
	map-comment "www.mendipcavinggroup.org.uk"
	#legend on         # turns on the symbol legend
    	legend-width 20 cm # printed size, based on scale
	grid bottom
	grid-size 100 100 100 m # x,y,z
        grid-coords border
	#debug on
	code metapost # xs,s,m,l,xl 
		fonts_setup(12,18,28,60,80); 
	#fonts_setup(<tinysize>,<smallsize>,<normalsize>,<largesize>,<hugesize>);
	# which may be used inside of the code metapost section of the layout command. <normalsize>
	# applies to point label, <smallsize> applies to remark and all other point labels.
	# Each of them may apply to line label according to its -size option.
	
	code metapost 
	        # change centre line to continuous
		def l_survey_cave (expr p) =
		  draw p withpen PenD withcolor (0.6, 0.6, 0.6);
		enddef;
		# Re-define North arrow to make it bigger
		def s_northarrow (expr rot) =
		  T:=identity scaled 0.7 rotated -rot;
		  thdraw (-1cm,-1cm)--(0,5cm)--(1cm,-1cm)--(0,0cm)--cycle;
		  thfill (-1cm,-1cm)--(0,5cm)--(0,0cm)--cycle;
		enddef;
        endcode
        
        #Change legen size
        #code tex-map
	#  \legendwidth=20cm
	#  \legendtextcolor={\color[0 0 100]}      # RGB values 0--100
	#  \legendtextsize={\size[20]}
	#  \legendtextheadersize={\size[60]}
	#endcode
	code tex-map
	\legendcontent={%
	  \hsize=\legendwidth
	  \ifnortharrow\vbox to 0pt{\line{\hfil\northarrow}\vss}\fi
	  \edef\tmp{\the\cavename} \ifx\tmp\empty \else
	    \color[0 0 0]{\size[90]\the\cavename}\color[0 0 0]\vskip1cm
	  \fi
	  #\ifscalebar\scalebar\vskip1cm\fi
	  {\rightskip=0pt plus 3em\parskip=3bp
	    \edef\tmp{\the\comment} \ifx\tmp\empty \else
	      {\size[24]\the\comment} \par\medskip
	    \fi
	    \everypar{\hangindent=2em\hangafter=1}
	    \edef\tmp{\the\cavelength} \ifx\tmp\empty \else
	      {\size[24]\si\the\cavelengthtitle: \ss\the\cavelength\par}
	    \fi
	    \edef\tmp{\the\cavedepth} \ifx\tmp\empty \else
	      {\size[24]\si\the\cavedepthtitle: \ss\the\cavedepth\par}
	    \fi
	    \edef\tmp{\the\exploteam} \ifx\tmp\empty \else
	      {\size[20]\si\the\explotitle:
	\ss\the\exploteam\quad\si\the\explodate\par}
	    \fi
	    \edef\tmp{\the\topoteam} \ifx\tmp\empty \else
	      {\size[20]\si\the\topotitle: \ss\the\topoteam\quad\si\the\topodate\par}
	    \fi
	    \edef\tmp{\the\cartoteam} \ifx\tmp\empty \else
	      {\size[20]\si\the\cartotitle:
	\ss\the\cartoteam\quad\si\the\cartodate\par}
	    \fi
	    \edef\tmp{\the\copyrights} \ifx\tmp\empty \else
	      {\size[24]\ss\the\copyrights\par}
	    \fi
	  }
	  \formattedlegend
	}
	endcode

endlayout

layout l2	# 1:2500 Map
	scale 1 2500
	#page-setup 21 29.7 28.7 20 0.5 0.5 cm
	overlap 1 cm       # margin sizem default 1cm
	surface bottom     # turns on or off surface bit-map
   	colour preview-below 0 # 100 0 53   # greyscale or x y z colour
   	colour preview-above 0 # 100 0 53   # greyscale or x y z colour
	map-header 0 5 sw  # turns on the map header positioned at (0,0)
	scale-bar 100 m
	#statistics topo-length on # per surveyor lengths
	statistics topo off # turns off list of surveyors
	map-comment "Copyright Mendip Caving Group 2007"
	#legend on         # turns on the symbol legend
    	#legend-width 10 cm # printed size, based on scale
	grid bottom
	grid-size 100 100 100 m # x,y,z
	#debug on
	code metapost
        	fonts_setup(10,15,20,25,50);
endlayout

select Map_m500@UpperFlood
#select Outline_m2500@UpperFlood
#select Map_Overlay@UpperFlood
#select EastPassage@UpperFlood
#select 6inGBS@UpperFlood
#select Geo_Surface@UpperFlood
export map -projection plan -layout l500 -o 0.Maps/UF_2500_surface.pdf
