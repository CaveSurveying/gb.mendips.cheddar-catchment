encoding  utf-8
source WallStreet.th
# Change name to the main therion file


#Surveys to output
#-----------------

export map -proj plan -layout local -o 0.Maps/WallStreet.pdf
#Produces plan of cave, on a single sheet

#export map -proj extended -layout local -o 0.Maps/WallStreetEe.pdf

export model -fmt survex -o 0.Maps/WallStreet.3d
#Survex file showing centre line only

export map -projection plan -format xvi -layout local -o 0.Maps/WallStreet.xvi

#export model -o 0.Maps/WallStreet.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o 0.Maps/WallStreet_Walls.3d
#Survex file showing walls only

layout local
scale 1 165
debug off
map-header 0 0 ne
#symbol-hide group cave-centreline
endlayout
