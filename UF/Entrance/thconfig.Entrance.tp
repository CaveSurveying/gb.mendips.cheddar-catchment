encoding  utf-8
source Entrance

layout l1
    colour map-fg 90
    scale 1 100
 	symbol-colour area water [0 0 100]
 	symbol-colour area flowstone [10 90 10]
 	symbol-colour area clay [100 100 0]
 	#symbol-hide group cave-centreline
endlayout
 
#cs EPSG:27700

select EntranceDisto_map@Entrance

export model -format survex -o 0.Maps/Entrance.3d
export map -projection plan -layout l1 -o 0.Maps/Entrance.pdf
#export map -projection plan -format xvi -layout l1 -o 0.Maps/Entrance.xvi
#export map -projection extended -format xvi -layout l1 -o 0.Maps/Entrance_Ex.xvi
#export atlas -projection plan -layout l1 -o 0.Maps/Entrance.pdf
