encoding  utf-8
source WillieStanton.th

language en_UK

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 200 
endlayout

export model -format survex -o 0.Maps/WillieStanton.3d
export model -format loch -o 0.Maps/WillieStanton.lox
export map -projection plan -format pdf -layout l1 -o 0.Maps/WillieStanton_CL.pdf
export map -projection extended -format pdf -layout l1 -o 0.Maps/WillieStanton_CLex.pdf
export map -projection elevation -format pdf -layout l1 -o 0.Maps/WillieStanton_CLel.pdf
export map -projection plan -format xvi -o 0.Maps/WillieStanton.xvi
export map -projection extended -format xvi -o 0.Maps/WillieStanton_ex.xvi
export map -projection elevation -format xvi -o 0.Maps/WillieStanton_el.xvi
