encoding  utf-8
source UpperFlood

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 500 
endlayout

# Select the first surveys for Extended output
select Entrance@UpperFlood
select Entrance2@UpperFlood
select MidnightChamber@UpperFlood
select GoldenChamber@UpperFlood
select BoulderChoke@UpperFlood
select MalcolmsWay@UpperFlood
select TrenchPassage@UpperFlood
select WallStreet@UpperFlood
select CharnelPassage@UpperFlood
select RoyalIcing@UpperFlood
select RoyalIcing2@UpperFlood

export map -projection extended -format pdf -layout l1 -o UF_CLex1.pdf
export map -projection extended -format xvi -o xvi/UF_CLex1.xvi
export map -projection elevation -format pdf -layout l1 -o UF_CLel1.pdf
export map -projection elevation -format xvi -o xvi/UF_CLel1.xvi
