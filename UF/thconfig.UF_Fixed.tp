encoding  utf-8
language en_UK

source UpperFlood
	
input layout.p_station_text.tp	
input layout.p_continuation.tp	
input layout.fixed_base.tp
input layout.p_smartlabel_lr.tp

layout l_fixed
        copy l_fixed_base
       	symbol-show point station:painted
	symbol-show point station:fixed
	symbol-show point station:natural

        copy l_p_smartlabel_lr
	copy l_p_station_text
	#copy l_p_continuation
endlayout

select Map_mFixedStations@UpperFlood
export map -projection plan -format pdf -layout l_fixed -o 0.Maps/UF_FIXED.pdf
export continuation-list -o 0.Maps/continuation-list.html
export continuation-list -o 0.Maps/continuation-list.txt

#unselect Map_mFixedStations@UpperFlood
#select UF_m1@UpperFlood
#export map -projection plan -format pdf -layout l_fixed -o 0.Maps/UF_FIXED_2.pdf
