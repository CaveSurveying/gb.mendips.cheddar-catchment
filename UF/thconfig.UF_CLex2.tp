encoding  utf-8
source UpperFlood

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 500 
endlayout

# Select the remainder surveys extended output
select EastPassage@UpperFlood
select WestPassage@UpperFlood
select Neverland@UpperFlood
select NeverlandRopeClimb@UpperFlood

export map -projection extended -format pdf -layout l1 -o UF_CLex2.pdf
export map -projection extended -format xvi -o xvi/UF_CLex2.xvi
export map -projection elevation -format pdf -layout l1 -o UF_CLel2.pdf
export map -projection elevation -format xvi -o xvi/UF_CLel2.xvi
