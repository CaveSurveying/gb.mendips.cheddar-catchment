encoding  utf-8

   survey Pony
     centreline
        team "Ben Cooper" instruments
        team "Mike Richardson" notes
        date 2007.12.14
        instrument length  "Ben's Bosch DLE50 laser rangefinder"
        instrument compass  "Ben's SAP #7"  
        instrument clino  "Ben's SAP #7"

        units clino compass degree
        units length meter
        
        sd tape    0.01  meter  # 1cm 
        sd clino  2  degree 
        sd compass  4  degree # Calibration problem with SAP for this survey

        #declination -2.97 deg  	# NOAA IGRF -2deg 58min at 2007.12.14 51.2987N 2.71038W
        #declination -2.936 deg 	# BGS at 2007.12.14 51.2987N 2.71038W 0.2km alt.  BGS 2010 Model.  Updated Nov 2011
									#http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
        declination -2.383 deg    	#Allign to grid, Grid North +0.55 deg
     endcentreline
     
     survey Rift
       centreline
        date 2007.12.14
        declination -2.383 deg    #Allign to grid, Grid North +0.55 deg
        # Starting from the rift potential connection to Neverland
        data normal \
        from  to  length  compass  clino          
                    # 1 is most obvious protrusion on LH wall (facing in) (RH wall in direction of survey)
        1  2  1.25  004.5  +82.4    # 2 is onto small boss in ceiling
        1  3  3.10  170.9  -02.3    # 3 is along rift is southerely direction
        data normal \
        from  to  length  compass  clino  left  right  up  down  # station Nr
        1  4  3.46  156.4  -64  [0.5 0.2] [0 0.9] [1.2 1] [1 0.5]  # 1 - 4 is back down climb
        4  5  2.96  347.4  +03  [0.9 0.4] [0.2 0]    0.8  1  # 5 is out towards West Passage
        5  6  2.24  341.6  -33  0  0.8  1  3.7  # 6 is in West Passage
        mark 6 painted                # Rift (to Neverland?)
       endcentreline
     endsurvey # Rift
     
     survey WP
       centreline
        date 2007.12.14
        declination -2.383 deg    #Allign to grid, Grid North +0.55 deg
        flags duplicate
        data normal \
        from  to  length  compass  clino  left  right  up  down  # station Nr
        6  7  5.75  078.4  -9.8  0  1.0  1.5  3.5  # 7 This section (6-8) is traverse over rift in floor
        7  8  7.47  086  +07  0.4  0  0.6  2.9  # 8
        8  9  5.74  095  -12  1.2  0  1.0  1.3  # 9
        9  10  3.26  017.2  +07.0  0  1.2  1.5  1.2  # 10
        10  11  13.71  088.9  +02.2  1.1  0  1.2  1.3  # 11
        11  12  3.53  028  +09.4  0  1.0  0.4  1.2  # 12 (11-12 is dog leg in passage)  
        11  13  7.4  085.3  +0.0  0.5  0  0.5  0.5  # 13 is blind side passage on South side
        data normal \
        from  to  length  compass  clino          
        11  14  4.6  319.5  +26.4    # 14 is blind side rift on North side
        data normal \
        from  to  length  compass  clino  left  right  up  down  # station Nr
        12  15  9.57  080.5  -0.5  0  1.2  0.7  0.7  # 15
        15  16  10.28  094.3  +02.4  0  0.6  1.4  1.1  # 16
        data normal \
        from  to  length  compass  clino          
        16  16a  0.5  -  UP    # estimated displacement for oxbow
        16a  17  3.0  056.4  +26.8    # 17 is oxbow, continues to RH and regains above Chuckle Choke
        data normal \
        from  to  length  compass  clino  left  right  up  down  # station Nr
        16  18  3.77  114.2  -02.3  1.2  0  0.7  1  # 18
        station 18 painted              # Chuckle Choke
        data normal \
        from  to  length  compass  clino          
        18  19  5.00  023.4  -45.9          # Down to Chuckle Choke
        data normal \
        from  to  length  compass  clino  left  right  up  down  # station Nr
        18  20  3.19  055.7  -09.9  0  1.7  0.5  0.3  # 20
        #20  21  10.00  108  -01  1.5  0  0.5  0.3  # 21 as written
        20  21  10.00  108.9  -04.6  1.5  0  0.5  0.3  # 21 from Pony
        #21  22  4.35  063  -03  0  1.3  0.6  0  # 22 as written
        21  22  4.35  068.2  -05.8  0  1.3  0.6  0  # 22 from Pony
        data normal \
        from  to  length  compass  clino          
        22  23  2.2  331.1  0    # 23 is blind phreatic tube, another one next door (East 2m)
        data normal \
        from  to  length  compass  clino  left  right  up  down  # station Nr
        22  24  6.76  081.3  0.6  1.8  0.4  0.5  0  # 24
        24  25  3.38  066.1  +28.7  0.8  0  0.4  0.2  # 25 First / Last station in low crawl
        25  26  3.56  014.2  +25.2  3.0  3.0  4.0  1.3  # 26 In large descent passage
        data normal \
        from  to  length  compass  clino          
        26  27  10.3  026.2  +52.5    # 27 climb into roof
        data normal \
        from  to  length  compass  clino  left  right  up  down  # station Nr
        26  28  5.81  140.3  +26.3  2.2  0.5  8  1.8  # 28
        28  29  4.30  112  +32.7  0.8  1.0  2.0  1.0  # 29
        29  30  2.30  124.6  +52.3  0.9  1.0  1.7  0.8  # 30
        30  31  4.13  141.1  +30.8  2.7  1.1  4.5  0.7  # 31
        31  32  1.45  267.0  +60.5  0  3.0  3.4  1.8  # 32 is Fixed station @ Neverland
        mark 32 fixed
        flags not duplicate
       endcentreline
     endsurvey # WP
   endsurvey # Pony        

