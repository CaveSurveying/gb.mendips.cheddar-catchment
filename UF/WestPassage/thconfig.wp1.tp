encoding  utf-8
source wp1.th
# Change name to the main therion file


#Surveys to output
#-----------------

#export map -proj plan -layout local -o 0.Maps/wp1.pdf
#Produces plan of cave, on a single sheet

#export map -proj extended -layout local -o 0.Maps/wp1Ee.pdf

export model -fmt survex -o 0.Maps/wp1th.3d
#Survex file showing centre line only

#export model -o 0.Maps/wp1.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o 0.Maps/wp1_Walls.3d
#Survex file showing walls only

layout local
debug off
map-header 0 0 ne
#symbol-hide group cave-centreline
endlayout
