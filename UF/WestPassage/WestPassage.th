encoding  utf-8
survey WestPassage -title "West Passage"

  #Export stations
  equate RI42  2.78@WPDisto # Start of Neverland in West Passage
  equate WP49  2.49@WPDisto # Start of Link Rift in West Passage
  
  #Connect lower surveys
  equate 2.0@Disto.ChucklesJoke 2.61@WPDisto
  
  
  # Connect Rift 
  # equate 6@WP_Rift  WP49   # Fixed station (Rift)
  equate 1.15@LRDisto.LinkRift WP49
  
  # OPTION: Include Pony survey
  equate 32@WP.Pony RI42
  input WestPassage.Pony.th

  # OPTION: Include Centre Line Survey.  
  equate d11@CentreLineOnly 24@WP.Pony
  input WestPassage.Centre.th
  
  input WestPassage.Disto.th
  input WestPassage_s0.th2		# West Passage chamber below Royal Icing, with entrance to Neverland
  input WestPassage_s1.th2		# Low muddy tube with Chuckle Choke and connection to Chuckle's Joke
  input WestPassage_s2.th2		# Vadose traverses, with connection to Rift and Tube connections to Neverland
  input WestPassage_s3.th2		# Final section with terminal boulder choke
  #input WestPassageRift_s1.th2

  # join WestPassage_s2      WestPassage_s3 # This produces an error, and anyway is not required (s2 is higher level rift)
  join WestPassage_s0 	   WestPassage_s1
  join WestPassage_s2 	   WestPassage_s3

  input LinkRift/LinkRift.th
  join wall_LRs1_1@LinkRift wall_WPs2_1
  join wall_LRs1_2@LinkRift wall_WPs2_2
  

  input ChucklesJoke/ChucklesJoke.th

  map WestPassage_map
	WestPassage_m0
	break
        WestPassage_mOffset
	WestPassage_m3
  endmap
  
  map WestPassage_mOffset
        LinkRift_map@LinkRift
	break
	WestPassage_m1
	break
	ChucklesJoke_map@ChucklesJoke
  endmap
  
  map WestPassage_m0
    WestPassage_s0
  endmap
  
  map WestPassage_m1 -title "West Passage"
    WestPassage_s1	# From RI to second dog-leg
    WestPassage_s2	# From second dog-leg to middle of final staight
  endmap
  
  map WestPassage_m3
    WestPassage_s3	# Final section with boulder choke at end
  endmap
  
endsurvey

