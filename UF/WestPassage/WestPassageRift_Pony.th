encoding  utf-8

     survey WP_Rift
       centreline
        team "Ben Cooper" instruments
        team "Mike Richardson" notes
        instrument length  "Ben's Bosch DLE50 laser rangefinder"
        instrument compass  "Ben's SAP #7"  
        instrument clino  "Ben's SAP #7"

        date 2007.12.14
        declination -2.383 deg    #Allign to grid, Grid North +0.55 deg

        # Starting from the rift potential connection to Neverland
        data normal \
        from  to  length  compass  clino          
                    # 1 is most obvious protrusion on LH wall (facing in) (RH wall in direction of survey)
        1  2  1.25  004.5  +82.4    # 2 is onto small boss in ceiling
        1  3  3.10  170.9  -02.3    # 3 is along rift is southerely direction
        data normal \
        from  to  length  compass  clino  left  right  up  down  # station Nr
        1  4  3.46  156.4  -64  [0.5 0.2] [0 0.9] [1.2 1] [1 0.5]  # 1 - 4 is back down climb
        4  5  2.96  347.4  +03  [0.9 0.4] [0.2 0]    0.8  1  # 5 is out towards West Passage
        5  6  2.24  341.6  -33  0  0.8  1  3.7  # 6 is in West Passage
        mark 6 painted                # Rift (to Neverland?)
       endcentreline
     endsurvey # Rift
