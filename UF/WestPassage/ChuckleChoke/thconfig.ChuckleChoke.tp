encoding  utf-8
language en_UK
source UF_ChuckleChoke.th

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 165
endlayout

export model -format survex -o 0.Maps/ChuckleChoke.3d
export model -format loch -o 0.Maps/ChuckleChoke.lox
export map -projection plan -format pdf -layout l1 -o 0.Maps/ChuckleChoke.CL.pdf
export map -projection extended -format pdf -layout l1 -o 0.Maps/ChuckleChoke.CLex.pdf
export map -projection elevation -format pdf -layout l1 -o 0.Maps/ChuckleChoke.CLel.pdf
export map -projection plan -format xvi -layout l1 -o 0.Maps/ChuckleChoke.xvi
export map -projection extended -format xvi -o 0.Maps/ChuckleChoke.ex.xvi
export map -projection elevation -format xvi -o 0.Maps/ChuckleChoke.el.xvi
