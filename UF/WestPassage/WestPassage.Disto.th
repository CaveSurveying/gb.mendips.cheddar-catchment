encoding  utf-8

survey WPDisto

   # Include some extra bits of survey to assist the drawing 
   # Attach surveys
   equate 42@RI    2.78   # Fixed Station (NeverLand)
   survey RI
     centreline
       date 2007.12.08
       declination -2.38 deg   #Allign to grid, Grid North +0.55 deg
       flags duplicate
	 data normal from to length compass clino left right up down
	 39  40  3.88  232  +38  0  0.5  6.0  0.5  # LRUD 40
	 40  41  1.35  312  -4  0.5  0  3.0  0.2  # LRUD 41

	 #West Passage
	 41  42  4.17  285  -24  0  3.0  3.4  1.8  # LRUD 42
       flags not duplicate
    endcentreline
  endsurvey # RI

  centreline
      team "Ben Cooper" instruments
      team "Mike Richardson" notes
      team "Ray Deasy" station # spotter 
      date 2009.05.29
      instrument length  "Ben's DistoX"
      instrument compass  "Ben's DistoX"  
      instrument clino  "Ben's DistoX"

      units clino compass degree
      units length meter
        
      sd length 1 centimeter
      sd compass 0.5 degree
      sd clino 0.5 degree
    
      #declination -2.747 deg  # BGS                in at 2009.05.29 51.2987N 2.71038W
      #declination -2.717 deg  # BGS at 2009.05.29 51.2987N -2.71038 0.2km alt.  2010 Model.  Updated Nov 2011.
				#http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
      declination -2.164 deg    #Allign to grid, Grid North +0.55 deg

 	  station 1.0 "Dig in dangerous boulder choke<br>Suspended 2011" dig continuation attr Name "WP0" attr left "left" attr dig "dig"
 	  
      mark 2.2 fixed  # 5mm drill hole, brass screw, plastic reflector # End of West Passage
	  station 2.2 "WP2 5mm drill hole, brass screw, plastic reflector" attr print "true" attr Code "fixed" attr Name "WP2"
	  station 2.2d "Dig in dangerous boulder choke" dig continuation attr Name "WP2" attr dig "dig"
	  station 2.5 "Dripping narrow rift" dig continuation attr Name "WP5"

	  station 2.18 "Possible mud-filled side tube" dig continuation attr Name "WP18" 
	  station 2.28 "Possible mud-filled side tube" dig continuation attr Name "WP28" attr lr "left"
	  station 2.29 "Possible mud-filled side tube" dig continuation attr Name "WP29" 
	  station 2.36 "Constricted tube, possible Neverland connection" dig continuation attr Name "WP36" attr dig "dig"
	  station 2.41 "Voice and light connection with bottom of Rift" continuation attr Name "WP41"
	  station 2.68 "Mud-filled key-shaped body-sized tube" dig continuation attr Name "WP68" attr dig "dig"

      mark 2.49 fixed  #5mm drill hole, brass screw, plastic reflector # Opposite rift
	  station 2.49 "WP49 5mm drill hole, brass screw, plastic reflector" attr print "true" attr Code "fixed" attr Name "WP49"
	  
      mark 2.61  fixed  # 5mm drill hole, brass screw, plastic reflector # Chuckle Choke
	  station 2.61 "WP61 5mm drill hole, brass screw, plastic reflector" attr print "true" attr Code "fixed" attr Name "WP61"

      mark 2.78 fixed  # 5mm drill hole, brass screw, plastic reflector # Neverland
	  station 2.78 "WP78 5mm drill hole, brass screw, plastic reflector" attr print "true" attr Code "fixed"  attr Name "WP78"

