encoding  utf-8

source UpperFlood

layout l2500	# 1:2500 Map
	scale 1 4000
	overlap 1 cm       # margin sizem default 1cm
	surface off        # turns on or off surface bit-map
        colour map-fg altitude
#   	colour preview-below [100 0 100]   # greyscale or x y z colour
 #  	colour preview-above [100 0 100]   # greyscale or x y z colour
	symbol-hide group cave-centerline
	map-header 0 5 off  # turns on the map header positioned at (0,0)
	scale-bar 100 m
	#statistics topo-length on # per surveyor lengths
	statistics topo off # turns off list of surveyors
	map-comment "Copyright Mendip Caving Group 2007"
	#legend on         # turns on the symbol legend
    	#legend-width 10 cm # printed size, based on scale
	grid bottom
	grid-size 100 100 100 m # x,y,z
	#debug on
	code metapost
        	fonts_setup(5,15,20,25,50);
endlayout

select Outline_m2500@UpperFlood
export map -projection plan -layout l2500 -o UF_2500_Bill.pdf
#export map -projection plan -layout l2500 -format kml -o UF_2500_Bill.kml
