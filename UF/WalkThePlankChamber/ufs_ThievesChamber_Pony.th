encoding  utf-8
 
survey ThievesChamber_Pony -title "Thieves Chamber" 
   
  centreline
	units clino compass degree
	units length meter

	date 2008.03.08    
	team "Ben Cooper"    instruments  # Instruments
	team "Tim Francis"   notes    # Note taker
	instrument length  "Ben's Bosch DLE50 laser rangefinder"
	instrument compass  "Ben's SAP #7"  
	#declination -2.887 deg  	# BGS at 2008-03-08 (2008.27) 51.2987N 2.71038W
	#declination -2.901 deg  	# BGS at 2008-03-08 51.2987N 2.71038W 0.2km alt.  2010 Model.  Updated Nov 2011
								# http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
	declination -2.348 deg    	# Allign to grid, Grid North +0.5535 deg

    sd compass 5 degrees		# It turns out Pony compass readings are unreliable
	sd clino 1 degrees
    sd length 1 centimetre

	# Into Thief's Chamber
	# LRUD taken in terms of direction of Survey (not the leg if reversed)

	data normal \
	from to	compass clino	length	left	right	up	down		# station Nr
	D1 D2	140.4	-00.8	4.95	[2.0 5.7] [1.3 2.5] [0.8 0] [0.6 0.4]	# D2 is edge of rock ceiling (step up immediately after)
	D2 D3	158.3	-07.5	3.4	0	0.9	[0.5 0.2]	0.2	# D3 within mud trench just before break-through	
	D3 D4	205.2	-02.8	5.24	0.3	0	0.6	0.2		# D4 is corner of mud trench beneath ceiling-rift
	D4 D5	150.2	+11.7	2.12	3.1	1.3	0.8	0.7		# D5
	D5 D6	269.0	+01.4	5.4	[1.3 .3] [3.1 .3]	0.2	0.7	# D6 - Est. LRUD. Blind rift, not entered (to protect mud floor)
	D5 D7	117.2	+01.6	2.53	4.7	2.0	1.8	0.8		# D7 - on stack of boulders below aven
	data normal from to compass clino	length 
	D7 D7a	186.8	+81.8	13						# D7a to visible roof of aven		
	data normal \
	from to	compass clino	length	left	right	up	down		# station Nr
	D7 D8	101.6	-10.5	9.24	1.4	4.6	3.0	0.9		# D8 - Tip of small straw (1cm long) on underside of overhang
	D8 D9	131.1	-15.4	2.34	0.5	0.6	0.1	0.6		# D9 - Into dig
	D9 D10	206.5	-20.8	2.6	0.7	0	.3	.3		# D10 within dig Est LRUD
	data normal from to compass clino length
	D10 D11	183.2	-31.1	1.65	

	data normal \
	from to	compass clino	length	left	right	up	down		# station Nr
	D8 U9	172.2	00.0	2.48	1.7	2.6	5.4	0		# U9 up slope into climb at end. Note: Up is onto roof, not into roof-rift
	U9 U10	091.7	+42.8	2.97	0	2.0	4.0	0		# U10 on LH wall on floor of slope
	U10 U11	121.9	+32.9	5.99	.4	.4	.4	.4		# U11 Est. LRUD.  back of obvious alcove
	data normal from to compass clino length
	U10 U12	131.3	+56.7	11.74	
  endcentreline
endsurvey

