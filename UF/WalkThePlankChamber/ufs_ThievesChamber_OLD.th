encoding  utf-8
 
survey TrenchPassage -title "Trench Passage" 
   
   centreline
    units clino compass degree
    units length meter

    team "Ben Cooper"    instruments  # Instruments
    team "Julie Hesketh"  notes    # Note taker
    instrument length  "Ben's Bosch DLE50 laser rangefinder"
    instrument compass  "Ben's SAP #7"  
    date 2007.12.08   #CHECK DATE - same as RI
    #declination -2.937 deg  	# BGS at 2007.12.08 (2007.94) 51.2987N 2.71038W
  				# http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
    declination -2.38 deg    	# Allign to grid, Grid North +0.5535 deg

    # LRUD taken in terms of direction of Survey (not the leg if reversed)
    data normal \
    from to length compass	clino 	left	right	up	down	# station Nr
    flags duplicate
      MW50 MW51	5.81	40.5	+5	[0.6 1]	[3.0 2.5]	[8.5 2]	[0.6 1.5]	# 51 Estimated LRUD		
      MW50 MW52	2.26	67	+33	6	3.0	7.5	0	# 52 Estimated LRUD
      extend left
      MW52 MW53	7.11	295	+24	5.6	0.9	7.0	0.2	# 53 REVERSED
      MW53 MW54	12.82	291	+36	0	3.5	0	1.5	# 54 Top of LH Wall
        data normal from to length compass clino				
      MW54 MW55	7.90	322	+6
      data normal from to length compass clino left right up down
      MW54	2	7.51	093	-34	[3.2 0] [0 4.7] [0 4.7]	[1.5 1.7]	# 1-2
        2	2a	5.54	120	-40	0.8	5.5	7.0	2		# 2a boulder in floor (see MW.Leg2)
        data normal from to length compass clino				
	2	2b	10.8	-	UP				# 2b - Aven 
        MW53	MW56	18.1	128	-5 				# duplicate legs from MW
        MW53	MW57	16.5	177	-5 				# duplicate legs from MW
    equate MW53 2a
    flags not duplicate

    extend right
    data normal \
    from to	length	compass clino	left	right	up	down	# station Nr
    2	3	8.55	173	-28	8.6	0	3.0	0.7	# 3 bottom of overhang
    3	4	6.93	136	-26	6.5	3.0	3.0	0	# 4 mud on floor edge of stream
    4	5	4.35	208	+08	6.0	0	2.0	0.4	# 5 RH wall / entrance to Trench	
    5	6	7.39	137	+24	5.0	0.5	2.1	1.0	# 6 
    6	7	5.38	151	0	6.0	0	0.3	1.4	# 7 on roof just before where stream comes in
    data normal from to length compass clino				
    6	6a	2	61	0					# Est leg to Crystal Dome
    6a	6b	8.6	-	UP					# Crystal Dome Aven

    data normal \
    from to length compass	clino 	left	right	up	down	# station Nr
    7	8	7.95	135	0	2.8	1.5	0.4	1.9	# 8
    8	9	9.29	130	-10	2.5	1.4	0.8	0.5	# 9
    mark 9 painted

    flags duplicate
     9	10	4.00	136	-02	0.2	1.6	0.3	0.2	# 10
     #11	9	7.40	325	+02					# 11 
     9	11	7.40	145	-02	0.2	1.5	0.2	0.5	# 11 est LRUD
     data normal from to length compass clino				
     11	12	2.8	207	-03					# 12 under 2" airspace, now dug, 
     # 12 now dug into Thief's Chamber
    flags not duplicate

    # End Passage of Plank Chamber  (Plank Grotto)
      date 2008.03.08    
      team "Ben Cooper"    instruments  # Instruments
      team "Tim Francis"   notes    # Note taker
      instrument length  "Ben's Bosch DLE50 laser rangefinder"
      instrument compass  "Ben's SAP #7"  
      #declination -2.887 deg  	# BGS at 2008.03.08 (2008.27) 51.2987N 2.71038W
  				# http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
      declination -2.33 deg    	# Allign to grid, Grid North +0.5535 deg
      data normal \
      from to	compass clino	length	left	right	up	down	# station Nr
      3 A2	129.3	-08.0	16.56	[8.6 4.3] [0 0.8] [3.0 0.8] [0.7 0.2]	# [3@two A2]
      A2 A3	090.6	-12.4	3.37	2.4	2.2	1.4	0.2		# A3
      A3 A4	132.0	-18.3	6.23	4.1	0	2.0	1.0		# A4
      A4 A5	089.2	-10.3	8.20	1	2	1	.3		# A5 Est. LRUD
	      									# A5 is tip of rock at end above sand
      flags duplicate # a couple of stations to fix side wall
       A2 B1	288.0	-10.8	5.79	[0 3.2] [8.6 3.8] [3.0 2.7] [0.7 0.3] # B1 is top of rocks close to drop
       data normal from to compass clino	length 
       B1 B2	196.2	+24	4.99					# B2 is LH corner of Trench Passage
      flags not duplicate

    # Into Thief's Chamber
      equate 9 D1								# D1 = 9
      data normal \
      from to	compass clino	length	left	right	up	down		# station Nr
      D1 D2	140.4	-00.8	4.95	[2.0 5.7] [1.3 2.5] [0.8 0] [0.6 0.4]	# D2 is edge of rock ceiling (step up immediately after)
      D2 D3	158.3	-07.5	3.4	0	0.9	[0.5 0.2]	0.2	# D3 within mud trench just before break-through	
      D3 D4	205.2	-02.8	5.24	0.3	0	0.6	0.2		# D4 is corner of mud trench beneath ceiling-rift
      D4 D5	150.2	+11.7	2.12	3.1	1.3	0.8	0.7		# D5
      D5 D6	269.0	+01.4	5.4	[1.3 .3] [3.1 .3]	0.2	0.7	# D6 - Est. LRUD. Blind rift, not entered (to protect mud floor)
      D5 D7	117.2	+01.6	2.53	4.7	2.0	1.8	0.8		# D7 - on stack of boulders below aven
      data normal from to compass clino	length 
      D7 D7a	186.8	+81.8	13						# D7a to visible roof of aven		
      data normal \
      from to	compass clino	length	left	right	up	down		# station Nr
      D7 D8	101.6	-10.5	9.24	1.4	4.6	3.0	0.9		# D8 - Tip of small straw (1cm long) on underside of overhang
      D8 D9	131.1	-15.4	2.34	0.5	0.6	0.1	0.6		# D9 - Into dig
      D9 D10	206.5	-20.8	2.6	0.7	0	.3	.3		# D10 within dig Est LRUD
      data normal from to compass clino length
      D10 D11	183.2	-31.1	1.65	

      data normal \
      from to	compass clino	length	left	right	up	down		# station Nr
      D8 U9	172.2	00.0	2.48	1.7	2.6	5.4	0		# U9 up slope into climb at end. Note: Up is onto roof, not into roof-rift
      U9 U10	091.7	+42.8	2.97	0	2.0	4.0	0		# U10 on LH wall on floor of slope
      U10 U11	121.9	+32.9	5.99	.4	.4	.4	.4		# U11 Est. LRUD.  back of obvious alcove
      data normal from to compass clino length
      U10 U12	131.3	+56.7	11.74	
   endcentreline
endsurvey

