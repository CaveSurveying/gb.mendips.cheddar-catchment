	#			
	#			% restore original labeling color
	#			pop_label_fill_color;
	#		fi;
	#	enddef;
	#endcode 	
endlayout

select Map_Continuations@UpperFlood
export map -projection plan -format pdf -layout l_fixed -o 0.Maps/UF_Continuations.pdf
export continuation-list -o 0.Maps/continuation-list.html
export continuation-list -o 0.Maps/continuation-list.txt
