encoding  utf-8
language en_UK

source UpperFlood

input layout.p_station_dig.tp	
input layout.p_continuation.tp	
input layout.fixed_base.tp
input layout.p_smartlabel_lr.tp

layout l_continuation
        copy l_fixed_base
        
	copy l_p_station_dig
	copy l_p_continuation
	copy l_p_smartlabel_lr

	symbol-hide point station:painted
	symbol-hide point station:fixed
	symbol-hide point station:natural
	symbol-hide point station:temporary
	
	symbol-show point flag:continuation
        symbol-show point flag:dig
        symbol-show point flag:sink
        symbol-show point flag:spring
        symbol-show point flag:sink
endlayout

select Map_Continuations@UpperFlood
#select UF_m1@UpperFlood
export map -projection plan -format pdf -layout l_continuation -o 0.Maps/UF_Continuations.pdf
export continuation-list -o 0.Maps/continuation-list.html
export continuation-list -o 0.Maps/continuation-list.txt
