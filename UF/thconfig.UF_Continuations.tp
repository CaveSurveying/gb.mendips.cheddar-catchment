encoding  utf-8
language en_UK

source UpperFlood

layout l_fixed
	scale-bar 10 m
        color map-fg [70 70 00]  
 	scale 1 4000
	
	symbol-hide group all
	symbol-show line wall
	symbol-show point station:painted
	symbol-show point station:fixed
	symbol-show point station:natural
	symbol-show point camp
	symbol-show point flag:continuation
	symbol-colour line wall [70 70 00]
