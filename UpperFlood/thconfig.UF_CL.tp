encoding  utf-8
source UpperFlood

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 165
endlayout

select Entrance@UpperFlood
select Entrance2@UpperFlood
select MidnightChamber@UpperFlood
select GoldenChamber@UpperFlood
select BoulderChoke@UpperFlood
select MalcolmsWay@UpperFlood
select TK1986@UpperFlood
select TrenchPassage@UpperFlood
select WallStreet@UpperFlood
select CharnelPassage@UpperFlood
select RoyalIcing@UpperFlood
select RoyalIcing2@UpperFlood
select EastPassage@UpperFlood
select WestPassage@UpperFlood
select Neverland@UpperFlood
select NeverlandRopeClimb@UpperFlood

export model -format survex -o UF.3d
export model -format loch -o UF.lox
export map -projection plan -format pdf -layout l1 -o UF_CL.pdf
export map -projection plan -format xvi -layout l1 -o xvi/UF.xvi
export map -projection [elevation 55 deg] -format pdf -layout l1 -o UF_CLel.pdf
export map -projection elevation -format xvi -o xvi/UF_el.xvi
export database -format sql -o UF.sql
