encoding  utf-8

source UpperFlood
#source Debug

layout l2500	# 1:2500 Map
	scale 1 8000
	overlap 1 cm       # margin sizem default 1cm
	surface off        # turns on or off surface bit-map
   	colour preview-below 0   # greyscale or [x y z] colour
   	colour preview-above 0   # greyscale or [x y z] colour
	map-header 0 5 off  # turns on the map header positioned at (0,0) 
        symbol-hide point cave-station
endlayout

select Outline_m2500@UpperFlood
select Centreline_m1@UpperFlood
export map -projection plan -layout l2500 -o UF_2500_Shirt.pdf
