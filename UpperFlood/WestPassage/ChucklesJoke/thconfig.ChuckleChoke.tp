encoding  utf-8
language en_UK
source ChucklesJoke.th

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 165
endlayout

export model -format survex -o 0.Maps/ChucklesJoke.3d
export model -format loch -o 0.Maps/ChucklesJoke.lox
export map -projection plan -format pdf -layout l1 -o 0.Maps/ChucklesJoke.CL.pdf
export map -projection extended -format pdf -layout l1 -o 0.Maps/ChucklesJoke.CLex.pdf
export map -projection elevation -format pdf -layout l1 -o 0.Maps/ChucklesJoke.CLel.pdf
export map -projection plan -format xvi -layout l1 -o 0.Maps/ChucklesJoke.xvi
export map -projection extended -format xvi -o 0.Maps/ChucklesJoke.ex.xvi
export map -projection elevation -format xvi -o 0.Maps/ChucklesJoke.el.xvi
