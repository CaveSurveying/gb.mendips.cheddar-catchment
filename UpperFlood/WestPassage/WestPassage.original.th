encoding  utf-8
survey WP_Original -title "West Passage"

    equate WP32 32@Pony 
    equate d11@CentreLineOnly 24@Pony
    survey CentreLineOnly
	  centreline
	    units clino compass degree
	    units length meter
	#    calibrate length 0.095  # missing first 10cm - check?
	    #declination -3.13 deg   #3deg 8 min West @ 2006.09.17  51.2987N 2.71038W (NOAA)
	    declination -2.58 deg   #Allign to grid, Grid North +0.55 deg
	    team "Tim Francis"
	    team "Dongwoo Park"
	    date 2006.10.07

	    extend start d8
	    extend left	#Westerly!
	    data normal from to length compass clino 
	    #d8 is start of West Passage
	    d8	d9	3.5	325	+1
	    #d9  d9a	8	310	-25	# estimate for entrance to Neverland
	    #d9a N1	2	220	0	# estimate to side wall fixed survey station at start of Neverland
	    d9	d10	19.5	310	-25
	    d10	d11	6.0	235	-35
	    d11	d12	13.5	270	-12
	    d12	d13	10.5	285	+3
	    d13	d14	13.0	285	+2
	    d14	d15	14.5	265	-3
	    d15	d16	12.5	265	+1
	    d16	d17	3.5	235	-2
	    d17	d18	17.0	270	-3
	    d18	d19	7.0	265	-8
	    d19	d20	2.0	190	-2
	    d20	d21	2.5	130	+2
	    d21	d22	3.5	167	+3
	    d22	d23	4.5	270	-3
	    d23	d24	8.5	285	-1
	    d24	d25	10.5	265	-3
	    d25	d26	5.5	0	-5
	    d26	d27	15.0	260	-2
	    d27	d28	10.0	270	-2
	    d28	d29	22.5	268	-2
	    d29	d30	10.0	265	0
	    d30	d31	21.0	270	-2
	    d31	d32	14.0	275	-3
	    d32	d33	5.0	200	-2
	    d33	d34	6.0	160	-3
	    d34	d35	3.15	215	+8
	  endcentreline
    endsurvey

    survey Pony
      centreline
        team "Ben Cooper" instruments
        team "Mike Richardson" notes
        date 2007.12.14
        instrument length  "Ben's Bosch DLE50 laser rangefinder"
        instrument compass  "Ben's SAP #7"  
        instrument clino  "Ben's SAP #7"

        units clino compass degree
        units length meter
        declination -2.38 deg  #Allign to grid, Grid North +0.55 deg

        # Starting from the rift potential connection to Neverland
        data normal \
        from	to	length	compass	clino					
        						# 1 is most obvious protrusion on LH wall (facing in) (RH wall in direction of survey)
        1	2	1.25	006	+82		# 2 is onto small boss in ceiling
        1	3	3.10	172	-02		# 3 is along rift is southerely direction
        data normal \
        from	to	length	compass	clino	left	right	up	down	# station Nr
        1	4	3.46	157	-64	[0.5 0.9] [0 0.2] [1.2 1] [1 0.5]	# 1 - 4 is back down climb
        4	5	2.96	348	+03	0.4	0	0.8	1	# 5 is out towards West Passage
        5	6	2.24	343	-33	0	0.8	1	3.7	# 6 is in West Passage
        mark 6 painted								# Rift (to Neverland?)
        6	7	5.75	079	-10	0	1.0	1.5	3.5	# 7 This section (6-8) is traverse over rift in floor
        7	8	7.47	087	+07	0.4	0	0.6	2.9	# 8
        8	9	5.74	095	-12	1.2	0	1.0	1.3	# 9
        9	10	3.26	017	+07	0	1.2	1.5	1.2	# 10
        10	11	13.71	088	+02	1.1	0	1.2	1.3	# 11
        11	12	3.53	028	+09	0	1.0	0.4	1.2	# 12 (11-12 is dog leg in passage)	
        11	13	7.4	086	+0	0.5	0	0.5	0.5	# 13 is blind side passage on South side
        data normal \
        from	to	length	compass	clino					
        11	14	4.6	320	+26		# 14 is blind side rift on North side
        data normal \
        from	to	length	compass	clino	left	right	up	down	# station Nr
        12	15	9.57	081	-0	0	1.2	0.7	0.7	# 15
        15	16	10.28	095	+02	0	0.6	1.4	1.1	# 16
        data normal \
        from	to	length	compass	clino					
        16	16a	0.5	-	UP		# estimated displacement for oxbow
        16a	17	3.0	057	+27		# 17 is oxbow, continues to RH and regains above Chuckle Choke
        data normal \
        from	to	length	compass	clino	left	right	up	down	# station Nr
        16	18	3.77	115	-02	1.2	0	0.7	1	# 18
        station 18 painted							# Chuckle Choke
        data normal \
        from	to	length	compass	clino					
        18	19	5.00	024	-45					# Down to Chuckle Choke
        data normal \
        from	to	length	compass	clino	left	right	up	down	# station Nr
        18	20	3.19	056	-09	0	1.7	0.5	0.3	# 20
        20	21	10.00	109	-01	1.5	0	0.5	0.3	# 21
        21	22	4.35	064	-03	0	1.3	0.6	0	# 22
        data normal \
        from	to	length	compass	clino					
        22	23	2.2	332	0		# 23 is blind phreatic tube, another one next door (East 2m)
        data normal \
        from	to	length	compass	clino	left	right	up	down	# station Nr
        22	24	6.76	082	0	1.8	0.4	0.5	0	# 24
        24	25	3.38	067	+28	0.8	0	0.4	0.2	# 25 First / Last station in low crawl
        25	26	3.56	015	+25	3.0	3.0	4.0	1.3	# 26 In large descent passage
        data normal \
        from	to	length	compass	clino					
        26	27	10.3	027	+52		# 27 climb into roof
        data normal \
        from	to	length	compass	clino	left	right	up	down	# station Nr
        26	28	5.81	141	+26	2.2	0.5	8	1.8	# 28
        28	29	4.30	113	+32	0.8	1.0	2.0	1.0	# 29
        29	30	2.30	125	+52	0.9	1.0	1.7	0.8	# 30
        30	31	4.13	142	+30	2.7	1.1	4.5	0.7	# 31
        31	32	1.45	268	+60	0	3.0	3.4	1.8	# 32 is Fixed station @ Neverland
        mark 32 painted
      endcentreline        
    endsurvey
endsurvey

