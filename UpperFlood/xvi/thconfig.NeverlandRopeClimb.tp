encoding  utf-8
source ../NeverlandRopeClimb.th

layout l1
        color map-fg 50  
 	scale 1 500 
endlayout
 

export model -format survex -o NeverlandRopeClimb.3d
export map -projection plan -format pdf -layout l1 -o NeverlandRopeClimb_CL.pdf
export map -projection extended -format pdf -layout l1 -o NeverlandRopeClimb_CLex.pdf
export map -projection elevation -format pdf -layout l1 -o NeverlandRopeClimb_CLel.pdf
export map -projection plan -format xvi -o NeverlandRopeClimb.xvi
export map -projection extended -format xvi -o NeverlandRopeClimb_ex.xvi
export map -projection elevation -format xvi -o NeverlandRopeClimb_el.xvi
