encoding  utf-8
source ../RoyalIcing.th

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 100
endlayout

export model -format survex -o RoyalIcing.3d
export model -format loch -o RoyalIcing.lox
export map -projection plan -format pdf -layout l1 -o RoyalIcing_CL.pdf
export map -projection extended -format pdf -layout l1 -o RoyalIcing_CLex.pdf
export map -projection elevation -format pdf -layout l1 -o RoyalIcing_CLel.pdf
export map -projection plan -format xvi -o RoyalIcing.xvi
export map -projection extended -format xvi -o RoyalIcing_ex.xvi
export map -projection elevation -format xvi -o RoyalIcing_el.xvi
