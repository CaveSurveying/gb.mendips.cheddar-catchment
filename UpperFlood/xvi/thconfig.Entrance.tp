encoding  utf-8
source ../CircleHill.th

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 165 
endlayout

export model -format survex -o CircleHill.3d
export model -format loch -o CircleHill.lox
export map -projection plan -format pdf -layout l1 -o CircleHill_CL.pdf
export map -projection extended -format pdf -layout l1 -o CircleHill_CLex.pdf
export map -projection elevation -format pdf -layout l1 -o CircleHill_CLel.pdf
export map -projection plan -format xvi -o CircleHill.xvi
export map -projection extended -format xvi -o CircleHill_ex.xvi
export map -projection elevation -format xvi -o CircleHill_el.xvi
