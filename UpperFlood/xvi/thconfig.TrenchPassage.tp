encoding  utf-8
source ../TrenchPassage.th

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 500 
endlayout

export model -format survex -o TrenchPassage.3d
export model -format loch -o TrenchPassage.lox
export map -projection plan -format pdf -layout l1 -o TrenchPassage_CL.pdf
export map -projection extended -format pdf -layout l1 -o TrenchPassage_CLex.pdf
export map -projection elevation -format pdf -layout l1 -o TrenchPassage_CLel.pdf
export map -projection plan -format xvi -o TrenchPassage.xvi
export map -projection extended -format xvi -o TrenchPassage_ex.xvi
export map -projection elevation -format xvi -o TrenchPassage_el.xvi
