encoding  utf-8
source ../Neverland.th

layout l1
        color map-fg 50  
 	scale 1 165 
endlayout
 

export model -format survex -o Neverland.3d
export model -format loch -o Neverland.lox
export map -projection plan -format pdf -layout l1 -o Neverland_CL.pdf
export map -projection extended -format pdf -layout l1 -o Neverland_CLex.pdf
export map -projection elevation -format pdf -layout l1 -o Neverland_CLel.pdf
export map -projection plan -format xvi -layout l1 -o Neverland.xvi
export map -projection extended -format xvi -o Neverland_ex.xvi
export map -projection elevation -format xvi -o Neverland_el.xvi
