encoding  utf-8
source ../WestPassage.th

layout l1
	scale-bar 100 m
        color map-fg 50  
 	scale 1 165 
endlayout

export model -format survex -o WestPassage.3d
export model -format loch -o WestPassage.lox
export map -projection plan -format pdf -layout l1 -o WestPassage_CL.pdf
export map -projection extended -format pdf -layout l1 -o WestPassage_CLex.pdf
export map -projection elevation -format pdf -layout l1 -o WestPassage_CLel.pdf
export map -projection plan -format xvi -layout l1 -o WestPassage.xvi
export map -projection extended -format xvi -o WestPassage_ex.xvi
export map -projection elevation -format xvi -o WestPassage_el.xvi
