encoding  utf-8
source ../MalcolmsWay.th

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 165
endlayout

export model -format survex -o MalcolmsWay.3d
export model -format loch -o MalcolmsWay.lox
export map -projection plan -format pdf -layout l1 -o MalcolmsWay_CL.pdf
export map -projection extended -format pdf -layout l1 -o MalcolmsWay_CLex.pdf
export map -projection elevation -format pdf -layout l1 -o MalcolmsWay_CLel.pdf
export map -projection plan -format xvi -layout l1 -o MalcolmsWay.xvi
export map -projection extended -format xvi -o MalcolmsWay_ex.xvi
export map -projection elevation -format xvi -o MalcolmsWay_el.xvi
