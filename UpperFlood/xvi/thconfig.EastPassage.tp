encoding  utf-8
source ../EastPassage.th

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 165 
endlayout
 

export model -format survex -o EastPassage.3d
export model -format loch -o EastPassage.lox
export map -projection plan -layout l1 -o EastPassage.pdf
export map -projection plan -format xvi -layout l1 -o EastPassage.xvi
export map -projection extended -format xvi -layout l1 -o EastPassage_ex.xvi
export map -projection elevation -format xvi -layout l1 -o EastPassage_el.xvi
#export atlas -projection plan -layout l1 -o EastPassage.pdf
