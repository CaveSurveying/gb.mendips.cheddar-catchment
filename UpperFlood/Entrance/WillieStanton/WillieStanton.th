encoding  utf-8
survey WS #WillieStanton -title "Entrance"

# Scan of Willie's notes supplied to me (Ben Cooper) courtesy of Graham Mullan, 2010.  
# This file developed during lumch times and train rides to London in 2011
# Interpretation of Willie's notes: 
# Dimensions UDLR: Confirmation from diagram on P80 that first dimension is definitely UP
# Do dimensions relate to the From or To station?  Hard to tell because of page break, but it appears from diagram on P80
#  that station 69 dimensions are provided against leg from station 69 to 70.  Hence conclude that dimensions are the From station.
# I assume "C, A, F, Tripod" means Compass, Altimeter(? but I assume means clinometer, ie angle off horizontal), Fibron tape
# I don't know what a Fibron tape is, but it was spelled out below
# NOTE drillmarks made by Willie are ~20mm in diameter and 20mm deep. Very easy to find when you know where to look!   

  equate 12@Surface 12@FS

  grade 6
	clino compass 0.25 deg
	tape 5 cm
  endgrade
  grade 5
    clino compass 0.5 deg
	tape 5 cm
  endgrade
  
  survey Surface
    centreline
      date 1972.04.13
      team "Willie Stanton"			# Paper notes cite no people.  I assume at least Willie Stanton
      units clino compass degree
      units length metres
      instrument compass "C, A, F, tripod"
      grade 6
      # declination -7:40 deg			# to Grid N.  Value from Willie Stanton's notes 1972.04.13
      # declination -7.667 deg  			# converted to decimal for Therion
      declination -7.630 deg			# 1972-04-13 to Grid North http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html  Oct 2011
      flags surface 

      data normal from to compass clino length
						# 1  800' contour crossing wall on 6" map
      1	2	-	UP	0.30		# 2
      2	3	293:00	+1:50	18.60		# 3
      3	4	277:00	-0:20	30.09		# 4
      4	5	288:00	+5:30	29.51		# 5
      5	6	264:40	+1:20	28.62		# 6
      6	7	258:20	+2:10	28.20		# 7 1m over centre of limekiln chimney base ("shaft"  on 6" map)
      7	8	351:10	-6:30	18.69		# 8
      8	9	343:45	-9:00	29.11		# 9 by track (W side)
      9	10	012:30	-2:20	13.91		# 10   
      10	11	349:50	-3:00	17.05	# 11
      11	12	342:22	-12:30	8.38	# 12 "inverted T" in pencil on W corner fence support post at ground level.
						# 2011 - no longer a fence around the entrance.  This has not existed in my memory ie since 1993, Ben Cooper		
    endcentreline
  endsurvey
  
  survey FS # Flood Swallet
    centreline
      date 1972.05.24
      team "Willie Stanton"
      team "Tom Davies"
      units clino compass degree
      units length metres

      walls on	# turn on LRUD wall generation for CL.pdf output
      instrument compass "C, A, F, tripod"
      grade 6
      # declination -7:00 deg			# to Grid N.  Value from Willie Stanton's notes 1972.05.24
      ##declination -7.000 deg  		# converted to decimal for Therion
      # ************* SUSPICIOUS DECLINATION VALUE.  Suggests error of 30' in compass if WS has measured decl against a reference station.  Assume SD 15'
      declination -7.500 deg  			# converted to decimal for Therion
      declination -7.619 deg 			# 1972.05.24 to Grid North http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html  Oct 2011 

      data normal from to compass clino length
      flags surface
      12	17	122:10	+13:00	2.20	# 17 2' above edge of pit
      17	18	106:00	-30:15	4.57	# 18 North edge of top of concrete ring
      flags not surface
      flags duplicate
      mark 18 fixed				# 18 North edge of top of concrete ring
      station 18 "WS18 North edge of top of ring" continuation attr Code "fixed" attr Name "WS18"
      data normal from to compass clino length up down left right
      18	19	-	DOWN	2.71	-	.3	.6	.6		# 19 2nd step down (steel ladder?  Original replaced c. 2008)
      19	20	154:10	-21:30	3.35	1.5	.6	.6	3		# 20 4' back from lip	
      20	21	150:40	-23:25	2.32	.6	2.4	-	-		# 21 3' above shot holes
      mark 21 fixed									# 21 3' above shot holes
	  station 21 "WS21 3' above shot holes" continuation attr Code "fixed" attr Name "WS21"
      21	22	-	DOWN	2.57	3	0	.6	.6		# 22 On steps (man-made stone steps)
      22	23	085:30	-24:10	2.26	1.5	.9	.9	.6		# 23 Bottom of steps , entrance of Fowl Crawl
      23	24	097:50	-10:00	8.82	.6	.9	.9	1.5		# 24 Large shallow drill mark on stal corbel (?) on S wall of half-way-house
      mark 24 fixed									# 24 Large shallow drill mark on stal corbel on S wall of half-way-house.  Found 12-11-2011
	  station 24 "WS24 Large shallow drill mark on stal corbel on S wall of half-way-house" continuation attr Code "fixed" attr Name "WS24"
      24	25	332:40	-21:00	2.32	1.2	.6	2.4	1.2		# 25 Over second step up in half-way-house
      25	26	087:00	-34:15	3.31	1.5	.15	.3	.5		# 26 Floor of main passage
      26	27	109:20	+4:30	6.49	1.2	.9	.6	.3		# 27 Main passage by "my" seat (ie Willie Stanton's)
      27	28	097:10	-5:30	7.31	1.5	.6	.3	.9		# 28 Drill mark in E wall above spring , at old sump.  Side rift enters 3.5m back towards 27
      mark 28 fixed									# 28 Drill mark in E wall above spring , at old sump.  Side rift enters 3.5m back towards 27
      station 28 "WS28 Drill mark in E wall above spring , at old sump.  Side rift enters 3.5m back towards 27" continuation attr Code "fixed" attr Name "WS28"
    endcentreline
    centreline -title "Upstream Entrance Grotto"
      date 1972.06.21
      data normal from to compass clino length up down left right
      team "Tom Davies"		# Paper notes cite "tom".  I assume Tom Davies
      instrument compass "C, A, F"
      grade 5
      # declination -7:20 deg	# to Grid N.  Value from Willie Stanton's notes 1972.06.21
      declination -7.333 deg  # converted to decimal for Therion
      declination -7.612 deg   # 1972.06.21 to Grid North http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html  Oct 2011 
      flags duplicate

      24	29	326:00	-20:30	3.34	.6	.6	.6	.6		# 29
      29	30	322:30	+1:00	5.18	.6	.3	1.2	.15		# 30 Squeeze over boss at 2m, then 8' wide and 5' high
      30	31	319:00	+19:00	5.33	.3	1.2	.6	1.8		# 31 3' wide after 2m.  Smoke mark on roof projection opposite side passage
      mark 31 painted									# 31 3' wide after 2m.  Smoke mark on roof projection opposite side passage
      31	32	327:00	+24:00	3.34	.6	.6	2.1	1.5		# 32 Steep rock slope in chamber, which is 8' high 2m before #33
      32	33	282:30	+31:00	5.94	.6	.15	1.2	1.5		# 33 Among boulders.  Passage (low) turns half right & continues 3m horiz to wide low chamber

      31	34	028:00	+0:30	3.19	.9	.6	.15	.15		# 34 Corner phreatic roof tube
      34	35	101:00	+9:00	2.13	.6	.9	.15	.3		# 35 Corner, 3' step up
      35	36	009:30	+6:20	5.25	.3	1.2	.3	.6		# 36 Corner & 4' drop, stal bridge at station level.  Vert joint
      36	37	102:00	-9:00	1.74	.9	1.2	.6	2.7		# 37 Station 37 is tip of 2nd longest stalactite.  R (2.7) to sump
      mark 37 fixed									# 37 Station 37 is tip of 2nd longest stalactite
      37	38	046:00	-2:00	3.04	.6	1.2	.3	.3		# 38 Phreatic roof tube
      38	39	340:00	+5:00	7.50	.3	1.8	.15	.3		# 39 Stal blockage in high thin rift, stream below in find tailings 

    endcentreline
    centreline
      date 1972.08.23
      team "Willie Stanton"		# Paper notes cite "Will".  I assume Willie Stanton
      team "Tom Davies"			# Paper notes cite "tom".  I assume Tom Davies
