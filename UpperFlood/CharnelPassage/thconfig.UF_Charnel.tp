encoding  utf-8
language en_UK
source UF_Charnel.th

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 200 
endlayout
 

export model -format survex -o 0.Maps/UF_Charnel.3d
export model -format loch -o 0.Maps/UF_Charnel.lox
export map -projection plan -layout l1 -o 0.Maps/UF_Charnel.pdf
export map -projection plan -format xvi -layout l1 -o 0.Maps/UF_Charnel.xvi
export map -projection extended -format xvi -layout l1 -o 0.Maps/UF_Charnel_ex.xvi
export map -projection [elevation 90] -format xvi -layout l1 -o 0.Maps/UF_Charnel_el90.xvi
#export atlas -projection plan -layout l1 -o 0.Maps/UF_Charnel.pdf
