encoding  utf-8
source ../CharnelPassage.th

layout l1
 	scale 1 165 
endlayout
 

export model -format survex -o CharnelPassage.3d
export map -projection plan -o CharnelPassage.pdf
export map -projection plan -format xvi -layout l1 -o CharnelPassage.xvi
