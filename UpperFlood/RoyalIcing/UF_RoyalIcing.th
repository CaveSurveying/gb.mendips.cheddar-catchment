    46  47  2.38  301  -31  0.3  0.3  0  0.4  # LRUD est. 47  Entrance to Tim's Tube
    47  48  3.00  317  +9  0.3  0.3  0.2  0.2  # LRUD est. 48 Tube
    
    46  49  5.24  022  +28  0.4  1.3  0  2.4  # LRUD 49
    49  50  6.72  040  +4  1.2  0  2  1.6  # LRUD 50
    data normal from to length compass clino
    #50  51  1.42  339  0          # 51 = 23
    50  23a  1.42  339  0
    equate 23a 23 # Close loop (Error 1.41% 0.7m)
    data normal from to length compass clino  left  right  up  down

    # Towards Royal Icing Chamber
    27  28  7.75  196  +1  [3.0 2.8] [1.4 1.5]  3.6  0  # LRUD 28
    mark 28 painted #  still visible 2010-08-07  This is on a small boulder - silly, it may easily move!!
    28  29  10.10  197  -2  2.0  0  6.0  1.3  # LRUD 29
    29  30  4.34  205  -17  2.1  0  9.0  0.7  # LRUD 30
    
    data normal from to length compass clino 
    30  31  4.60  328  -33          # Tube
    30  32  8.0  143  +6              # Rift
    data normal from to length compass clino  left  right  up  down
    30  33  5.65  168  +29  0  0.6  3.0  1.3  # LRUD 33
    33  34  4.38  177  +17  0  0.6  0.7  0.5  # LRUD 34  Climb looks interesting
    34  35  2.62  177  +13  0  1.3  3.0  1.0  # LRUD 35

    # Royal Icing Chamber
    35  36  2.23  232  +15  4.0  0  6.4  2.8  # LRUD 36
    mark 36 fixed # Royal Icing Chamber
  station 36 "RI36 5mm hole, brass screw, reflector on West wall" continuation attr code "fixed" attr Name "RI36"
    
    # East passage legs included for drawing
    flags duplicate
  data normal from to length compass clino left right up down    # 1 is fixed station 36@RI
  36  EP2  4.50  094  -03  [3.7 1.6] [10.2 2.8] [0.8 6.0] [3.0 1.5]# 2 on boulder
  EP2 EP3  5.54  050   -15  6.0  1.5  2.3  2.3    # 3 on boulder
  EP3 EP4  4.46  021  -24  0.0  2.4  2.8  1.2    # 4 LH wall
  EP4 EP5  8.04  107  +0  2.1  2.6  0  0.8    # 5 low ceiling above taped off mud
    flags not duplicate
    
    # Down into the floor of Royal Icing Chamber    
    35  37  6.46  259  -41  0  0.4  1.0  1.0  # LRUD 37
    37  38  2.6  289  -31  .2  .2  1  1  # LRUD est.
    
    36  39  6.86  188  +1  2.7  1.2  4.0  0.6  # LRUD 39
