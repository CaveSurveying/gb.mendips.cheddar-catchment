    6  10  4.91  205  +20  [0.4 2.5] [3.3 0] [1.1 2.4] [0 1.4] # LRUD 6-10 (Mike referenced wrong station)
    10  11  6.90  150  +15  .1  .1  2  1  # LRUD 11 (Side Rift)
    10  12  7.58  190  +4  0  0.7  1.0  .02  # LRUD 12  (Up into roof is 3.6m, down into floor is 5m)
    12  13  4.88  224  -14  1.1  0  3.5  0.8  # LRUD 13 (top of climb down from Nertherwood Flyover)
    #14  13  2.71  25  +58  1  0  4.8  0.5  # LRUD 14 (LRUD specified in direction of leg)  NOTE: blunder in notes.  Correct clino shown here, verified from SAP NVRAM
    13  14  2.71  205  -58  0  1  4.8  0.5  # LRUD 14 (LRUD specified in direction of leg)

    # Halogen Loft
    14  15  4.40  343  -42  [1 0]  [0 0.6]  0  0.6  # LRUD 15 (back down towards the stream
    15  16  1.57  16  -34  0.7  0  0.8  1.0  # LRUD 16
    16  1a  1.85  341  +1  0.6  1.0  0.9  1.0  # LRUD 1
    equate 1 1a    # Close loop  (Error: 0.6m, 1.36%)
    
    # Lowest level
    14  17  2.74  243  -17  [0 0.5]  [1 0]  6.0  1.3  # LRUD 17
    17  18  3.21  202  -10  0  0.6  1.5  1.0  # LRUD 18
