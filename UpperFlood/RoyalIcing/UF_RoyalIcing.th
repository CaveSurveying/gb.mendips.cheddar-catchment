encoding  utf-8
survey RoyalIcing -title "Royal Icing Passage"

  centreline
    units clino compass degree
    units length meter

    team "Ben Cooper"    instruments  # Instruments
    team "Mike Richardson"  notes    # Note taker
    instrument length  "Ben's Bosch DLE50 laser rangefinder"
    instrument compass  "Ben's SAP #7"
    date 2007.12.06 # Not entirely sure of the day.  This was a mid-week trip either the Wed or the Thur before Sat 8th Decemer.   
    #declination -2.97 deg   # NOAA IGRF -2deg 58min at 2007.12.14 51.2987N 2.71038W
    declination -2.42 deg    #Allign to grid, Grid North +0.55 deg
    #declination -2.937 deg    # BGS at 2007.12.08 (2007.94) 51.2987N 2.71038W
          # http://www.geomag.bgs.ac.uk/gifs/wmm_calc.html
    declination -2.385 deg      # Allign to grid, Grid North +0.5535 deg

    # LRUD taken in terms of direction of Survey (not the leg if reversed)
    data normal from to length compass clino  left  right  up  down
    # MW9 = 9@MalcolmsWay.  This is a vulnerable position, so a new Permanent station has been set up near by (station 1)
    flags duplicate
  MW9  1  1.55  04  +01  [1.4 0.6] [0.8 1.0] [0.4 0.9] [1.2 1.0]  #LRUD MW9 to 1
  mark 1 fixed  # Small drilled indentation
  station 1 "Small drilled indentation on West Wall" continuation attr code "fixed" attr Name "RI2"
  
  1  2  3.81  43  -1  1.0  0  1.8  0.8  # LRUD 2
  2  3  5.52  16  +5  0.9  0.3  3.2  0.9  # LRUD 3
  3  4  1.82  305  +44  0  1.8  2.0  2.5  # LRUD 4
  mark 4 natural # Tip of Small protuding stal cylinder, 3" long
  station 4 "RI4 Tip of Small protuding stal cylinder, 3-inches long, on West wall, 2.5m above stream" continuation attr code "fixed" attr Name "RI4"
    flags not duplicate 

    # Netherwood Inlet Passage
    4  5  4.41  38  +38  0  2.3  4.0  1  # LRUD 5 (on wall towards Netherwood Inlet)
    5  6  2.93  109  +12  1.2  0.4  1.1  0  # LRUD 6 (on floor just before inlet)
    6  7  3.8  31  +32  0  0.6  0.3  0.3  # LRUD 7 (inside Netherwood Inlet Passage)
    7  8  2.76  20  +12  0.3  0.6  0.6  0.4  # LRUD 8
    8  9  2.49  64  +53  0.2  0.2  0  2.0  # LRUD 9 (estimated: end of Nerthwood Inlet)

    # Netherwood Flyover
