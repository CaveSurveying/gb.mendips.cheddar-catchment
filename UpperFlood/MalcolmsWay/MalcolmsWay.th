encoding  utf-8
survey MalcolmsWay -title "Malcolm's Way"

  centreline
    #Join surveys
    equate 35@Leg1 51@Leg2    # Painted
	equate 1.0@BusinessLounge 	MW13
	equate 1.2@DuckPond1		MW24
	equate 1.5@DuckPond1		1.5@DuckPond2
	
	equate 1.2@Flyover1			41@Leg2
	equate 1.4@Flyover2			1.4@Flyover1
	
	#Export statiomns
	equate	MW13	13@Leg1
	equate	MW17	17@Leg1
	equate	MW24	24@Leg1
	equate  MW41a	1.1@Flyover1
	equate  MW35a	2.10@Flyover2
	
	mark MW24 natural
	station MW24 "highest tip of two boulders upstream of Duck-Under-Boss"  attr print "true" attr fixed "fixed" attr Name "MW24"
	
	mark 1.1@Flyover1 fixed
	station MW41a "Fixed reflector" continuation attr fixed "fixed"  attr print "true" attr fixed "fixed" attr Name "MW41a"
	
	mark 2.10@Flyover2 fixed
	station MW35a "Fixed reflector" continuation attr fixed "fixed"  attr print "true" attr fixed "fixed" attr Name "MW35a"

    equate	PAINTED-MW1-stal	1@Leg1       
    equate	PAINTED-MW51-stal	51@Leg2
  endcentreline
  
  input MW_Leg1.th
  input MW_Leg2.th

   input DepartureLounge_s1.th2
   input MalcolmsWay_s1.th2
   input MalcolmsWay_s2.th2
   input MalcolmsWay_s3.th2
   input MalcolmsWay_s4.th2
   # ID convetion:  <item>_<Passage Initials><Scrap Number>_<Sequence>  Sequence counts L->R; Up->Down
   #join MalcolmsWay_s2 MalcolmsWay_s1
   #join MalcolmsWay_s3 MalcolmsWay_s2

  input BusinessLounge.th
  input DuckPond1.th
  input DuckPond2.th
  input DuckPond_s1.th2
  input DuckPond_s2.th2
  
  input Flyover1.th
  input Flyover2.th
  input Flyover_s1.th2
  input Flyover_s2.th2
  
   map MalcolmsWay_map
	   DuckPond_s2
	   break
	   DuckPond_s1
	   break
       MalcolmsWay_s1
	   Flyover_s1
	   break
       DepartureLounge_s1
       MalcolmsWay_s2
	   Flyover_s2
       break
       MalcolmsWay_s3 
       break
       MalcolmsWay_s4 
   endmap
   
  
endsurvey

