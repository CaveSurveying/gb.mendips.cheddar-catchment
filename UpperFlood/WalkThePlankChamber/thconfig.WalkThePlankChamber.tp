encoding  utf-8
source WalkThePlankChamber.th

layout l1
	grid bottom
	grid-size 1 1 1 m # x,y,z
	scale-bar 10 m
        color map-fg 50  
 	scale 1 100 
endlayout

export model -format survex -o 0.Maps/WalkThePlankChamber.3d
#export model -format loch -o 0.Maps/WalkThePlankChamber.lox
export map -projection plan -format pdf -layout l1 -o 0.Maps/WalkThePlankChamber_CL.pdf
#export map -projection extended -format pdf -layout l1 -o 0.Maps/WalkThePlankChamber_CLex.pdf
#export map -projection elevation -format pdf -layout l1 -o 0.Maps/WalkThePlankChamber_CLel.pdf
#export map -projection plan -format xvi -layout l1 -o 0.Maps/WalkThePlankChamber.xvi
# Trench Passage was originally drawn to 1:200
layout l2
 	scale 1 200 
endlayout
export map -projection plan -format xvi -layout l2 -o 0.Maps/TrenchPassage.xvi
export map -projection extended -format xvi -o 0.Maps/WalkThePlankChamber_ex.xvi
export map -projection elevation -format xvi -o 0.Maps/WalkThePlankChamber_el.xvi

select WalkThePlankChamber_m1
export map -projection plan -format pdf -layout l1 -o 0.Maps/WalkThePlankChamber.pdf
