encoding  utf-8
source ../BoulderChoke.th

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 165 
endlayout

export model -format survex -o BoulderChoke.3d
export model -format loch -o BoulderChoke.lox
export map -projection plan -format pdf -layout l1 -o BoulderChoke_CL.pdf
export map -projection extended -format pdf -layout l1 -o BoulderChoke_CLex.pdf
export map -projection elevation -format pdf -layout l1 -o BoulderChoke_CLel.pdf
export map -projection plan -layout l1 -format xvi -o BoulderChoke.xvi
export map -projection extended -format xvi -o BoulderChoke_ex.xvi
export map -projection elevation -format xvi -o BoulderChoke_el.xvi
