encoding  utf-8
survey NeverlandRopeClimb -title "Neverland Rope Climb"

  centreline
    team "Ben Cooper" instruments
    team "Mike Richardson" notes
    team "Julie Hesketh" 
    date 2007.08.04
    instrument length  "Ben's Bosch DLE50 laser rangefinder"
    instrument compass  "Phil Underwood's SAP"  
    instrument clino  "Phil Underwood's SAP"
    
    units clino compass degree
    units length meter
    #walls on
    declination -2.58 deg  #Allign to grid, Grid North +0.55 deg

    extend start N38
    extend left
    flags duplicate
        data normal from to length compass clino 
        N38  N39  10.29  271  0.5          #  N39 On back wall of sort of t-junction
        data normal from to length compass clino left right up down    
        N39  N40  12.72  147  -7  0.00  1.10  2.20  1.00  #N40  
        N40  1  5.76  215  7	3.1	0.9	4.7	5.8	#1=N41  Pitch head. Pinnacle on edge.
    flags not duplicate
    
    data normal from to length compass clino left right up down    #LRUD   Station description
