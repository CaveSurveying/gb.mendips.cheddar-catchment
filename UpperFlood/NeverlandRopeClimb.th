    19 11	2.98	236	+20	1.4	0.4	8.3	1.5	#11 in reverse direction ?    
    data normal from to length compass clino
    extend left
    11 21	7.95	195	+05 					#21 is into blind tunnel above duck

    # RH at duck junction
    extend left
    data normal from to length compass clino left right up down    
    9 22	4.94	261	-06	0.6	0.6	0.1	0.2	#22 Lowest of three stalagtites
    #23 22a	4.61	101	-04	1.2	1.8	0.4	0.1	#23 (check L-R ... reverses for reverse leg)
