encoding  utf-8
survey EastPassage -title "East Passage"

  equate E6@EP_CL         14@EP_Pony
  equate 53@DeepPoolTube        53@EP_Pony       
  equate 2@DeepPoolTube          54@EP_Pony       
  equate 53@DownUnder          53@EP_Pony       
  equate START@BeyondZebraAven  41@EP_Pony
  
  # Close loop between Muddy Hell and Rift Series
  equate 35s@EP_Pony  1.11@CrossRift2.BeyondZebraAven

  input EastPassageCL.th
  input EastPassagePony.th
  input DeepPoolTube.th
  input DownUnder.th
  input BeyondZebraAven/BeyondZebraAven.th

  input EastPassage_s1.th2
  input WaterWorks_s1.th2
  join EastPassage_s1 BeyondZebraAven_s1@BeyondZebraAven
  
  input DownUnder.th2

  map EastPassage_map
    EastPassage_m1a
    EastPassage_m1b
    DownUnder_m1 [40 40] below
  endmap
  
  map EastPassage_m1a -title "East Passage"
    EastPassage_s1
    break
    WaterWorks_s1
  endmap

  map EastPassage_m1b
    BeyondZebraAven_map@BeyondZebraAven
  endmap
  
  map DownUnder_m1
    DownUnder_s1
  endmap
endsurvey

