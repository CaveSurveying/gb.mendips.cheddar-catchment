encoding  utf-8
language en_UK
source AwolAven.th

layout l1
	scale-bar 10 m
        color map-fg 50  
 	scale 1 200 
endlayout

select AwolAven_m1@AwolAven
select AwolAvenEl_m1@AwolAven

export map -projection plan -layout l1 -o 0.Maps/AwolAven.pdf
export map -projection [elevation 128] -layout l1 -o 0.Maps/AwolAven_el128.pdf
