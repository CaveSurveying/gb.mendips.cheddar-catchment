encoding  utf-8
source DrunkenHorse.th
# Change name to the main therion file


#Surveys to output
#-----------------

export map -proj plan -layout local -o DrunkenHorse.pdf
#Produces plan of cave, on a single sheet

#export map -proj extended -layout local -o DrunkenHorseEe.pdf
#Produces plan of cave, on a single sheet

#export model -fmt survex -o DrunkenHorseth.3d
#Survex file showing centre line only

export model -o DrunkenHorse.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o DrunkenHorsesurvey_Walls.3d
#Survex file showing walls only

layout local
debug off
scale 1 200
symbol-hide group cave-centerline
colour map-fg 100
colour map-bg 90

symbol-hide point section
endlayout
