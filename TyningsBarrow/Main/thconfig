encoding  utf-8
select Main
source Main.th
# Change name to the main therion file


#Surveys to output
#-----------------

export map -proj plan -layout local -o Main.pdf
#Produces plan of cave, on a single sheet

#export map -proj extended -layout local -o MainEe.pdf
#Produces plan of cave, on a single sheet

#export model -fmt survex -o Mainth.3d
#Survex file showing centre line only

export model -o Main.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o Main_Walls.3d
#Survex file showing walls only

layout local
debug off
scale 1 200
symbol-hide group cave-centerline
colour map-fg 100
colour map-bg 90

symbol-hide point section
endlayout
