encoding  utf-8
survey Great_Swallet -title "Great_Swallet<br>Charterhouse"


import Great_Swallet.3d -surveys use -filter great_swallet -cs EPSG:27700 -calibrate [0 0 0 300000 100000 0]
#-calibrate [0 0 0 299912 99991 0]
#Should be -calibrate [0 0 0 300000 100000 0]
#bodge to compensate for not doing datum shift between
#Airy and WGS84 ellipsoids

input "Great_Swallet.th2"

map Great_Swallet
  Great_SwalletScP1
  Great_SwalletScP2
  Great_SwalletScP3
  Great_SwalletScP4
endmap

endsurvey

