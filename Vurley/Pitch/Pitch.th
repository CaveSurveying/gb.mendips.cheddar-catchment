encoding  utf-8
survey Pitch

input PitchP.th2
input PitchE0.th2
input PitchE90.th2

map PitchMP -title "Pitch - Plan"
  PitchSP1
  break
  PitchSP2
endmap

map PitchME0 -title "Pitch<br>Elevation Looking North"
  PitchSE01
endmap

map PitchME90 -title "Pitch<br>Elevation Looking East"
  PitchSE901
endmap

