encoding  utf-8
survey Pitch

input PitchP.th2
input PitchE0.th2
input PitchE90.th2

map PitchMP -title "Pitch - Plan"
  PitchSP1
  break
  PitchSP2
  break
  PitchSP3
  break
  PitchSP4
  break
  PitchSP5
endmap

map PitchME0 -title "Pitch<br>Elevation Looking North"
  PitchSE02
  break
  PitchSE01
endmap

map PitchME90 -title "Pitch<br>Elevation Looking East"
  PitchSE901
  break
  PitchSE902
endmap

