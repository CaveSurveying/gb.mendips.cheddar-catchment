encoding  utf-8
source Pitch.th

select PitchMP@Pitch
select PitchME0@Pitch
select PitchME90@Pitch

export model -o Outputs/Pitchth.3d

export model -o Outputs/Pitch.lox

export map -proj plan -layout plan -o Outputs/PitchP.pdf
export map -proj plan -layout plan -o Outputs/PitchP.xvi

export map -proj [elevation 90 deg] -layout elevation90 -o Outputs/PitchE90.pdf
export map -proj [elevation 90 deg] -layout elevation90 -o Outputs/PitchE90.xvi

export map -proj elevation -layout elevation0 -o Outputs/PitchE0.pdf
export map -proj elevation -layout elevation0 -o Outputs/PitchE0.xvi

#export map -proj elevation -layout elevationcombined -o Outputs/ElevationCombined.pdf

layout plan
copy local
code tex-map
  \cavename={\size[20] Pitch Plan View}
  \cavelength={}%empty
  \cavedepth={}%empty
  \colorlegendfalse
endcode
endlayout

layout elevation90
copy local
code tex-map
  \cavename={\size[20] Pitch Elevation Looking East}
  \cavelength={}%empty
  \cavedepth={}%empty
  \colorlegendfalse
endcode
endlayout

layout elevation0
copy local
code tex-map
  \cavename={\size[20] Pitch Elevation Looking North}
  \cavelength={}%empty
  \cavedepth={}%empty
  \colorlegendfalse
endcode
endlayout

#layout elevationcombined
#copy local
#map-image 0 0 se Outputs/PitchE0.pdf
#map-image 0 0 sw Outputs/PitchE90.pdf
#map-header 0 0 off
#symbol-hide special scale-bar
#code tex-map
#  \cavename={\size[20] }
#  \cavelength={}%empty
#  \cavedepth={}%empty
#  \colorlegendfalse
#endcode
#endlayout

layout local
north grid
grid bottom
grid-size 5 5 5 metres
symbol-hide point remark
#symbol-hide group cave-centreline
statistics explo off
statistics topo-length off
transparency on
map-header 0 0 nw
code tex-map
  \cavelength={}%empty
  \cavedepth={}%empty
  \colorlegendfalse
endcode
endlayout

input ../../common_layout.th
