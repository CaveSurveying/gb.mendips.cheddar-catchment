encoding  utf-8
source Vurley.th
# Change name to the main therion file


#Surveys to output
#-----------------

#export model -o Outputs/Vurley.lox

export model -fmt survex -o Outputs/Vurley.3d

export model -fmt kml -o Outputs/Vurley.kml

export map -proj plan -layout plan -o Outputs/VurleyP.pdf

export map -proj elevation -layout elevation0 -o Outputs/VurleyE0.pdf

export map -proj [elevation 90] -layout elevation90 -o Outputs/VurleyE90.pdf

export map -proj elevation -layout elevationcombined -o Outputs/VurleyECombined.pdf

layout plan
copy local
north grid
symbol-hide point remark
statistics explo off
statistics topo-length off
transparency on
#color map-fg altitude
map-header 0 0 nw
map-header-bg off
map-comment "Location ST 47993 53391 Alt. 221.7m OD<br>\
Length 205 m (surveyed 2023)<br>\
Depth 129 m (surveyed 2023)<br>\
Drawn using Therion by John Cooper, Draft 21/06/2023<br>\
Survey by John Cooper, Adrian and Jude Vanderplank<br>\
Grade UISv1 6-4-EF<br>\
Copyright 2011-23 CC BY NC SA<br>\
Data available at http://cave-registry.org.uk/"

scale-bar 25 metres

code tex-map
  \cavename={\size [30] Vurley Swallet Plan View} 
    \cavelength={} %empty
    \cavedepth={}  %empty
    \colorlegendfalse   
endcode
endlayout

layout elevation0
copy local
map-header 50 0 center
scale-bar 25 metres
scale 1 100
base-scale 1 400
code tex-map
  \cavename={\size [24] Vurley Swallet Elevation Looking North} 
    \cavelength={} %empty
    \cavedepth={}  %empty
    \colorlegendfalse   
endcode 
endlayout

layout elevation90
copy local
map-header 50 0 center
scale-bar 25 metres
scale 1 100
base-scale 1 400
code tex-map
  \cavename={\size [24] Vurley Swallet Elevation Looking East} 
    \cavelength={} %empty
    \cavedepth={}  %empty
    \colorlegendfalse  
endcode 
endlayout

layout elevationcombined
map-image 0 0 sw Outputs/VurleyE0.pdf
map-image 0 0 se Outputs/VurleyE90.pdf
map-header 0 0 off
symbol-hide special scale-bar
code tex-map
  \cavename={\size[20] }
  \cavelength={} %empty
  \cavedepth={}  %empty
  \colorlegendfalse  
endcode 
endlayout

layout local
symbol-hide group cave-centreline
colour-legend off
grid bottom
grid-size 5 5 5 metres
code tex-map
  \cavelength={}%empty
  \cavedepth={}%empty
  \colorlegendfalse
  \topoteam={}%empty
endcode
endlayout

#get the master layout settings
input ../common_layout.th
