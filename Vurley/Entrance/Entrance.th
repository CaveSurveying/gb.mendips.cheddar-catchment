encoding  utf-8
survey Entrance

input EntranceP.th2
input EntranceE0.th2
input EntranceE90.th2

map EntranceMP -title "Vurley Swallet - Plan"
  EntranceSP1
  break
  EntranceSP2
  break
  EntranceSP3
  break
  EntranceSP4
  break
  EntranceSP5
  break  
endmap

map EntranceME0 -title "Vurley Swallet<br>Elevation Looking North"
  EntranceSE02
  break
  EntranceSE01
endmap

map EntranceME90 -title "Vurley Swallet<br>Elevation Looking East"
  EntranceSE902
  break
  EntranceSE901
endmap

centreline
cs OSGB:ST
fix 1.0 47992.6 53390.6 221.74
