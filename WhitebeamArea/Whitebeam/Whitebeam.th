encoding  utf-8
survey Whitebeam

input Entrance/Entrance.th
input Lower/Lower.th
input Upper/Upper.th

equate 4.11@Entrance 5.0@Lower
equate 5.4@Lower 6.0@Upper

map WhitebeamM -title "Whitebeam Slitter Cave"
  EntranceM@Entrance
  LowerM@Lower
  UpperM@Upper
endmap

map WhitebeamME90 -proj [elevation 90]
  EntranceME90@Entrance
  LowerME90@Lower
  UpperME90@Upper
endmap

join UpperSE90_1@Upper LowerSE90_1@Lower -smooth on
join EntranceSE90_1@Entrance LowerSE90_1@Lower -smooth on 

endsurvey

