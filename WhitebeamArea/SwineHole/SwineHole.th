encoding  utf-8
survey SwineHole

input SwineHole.th2
input SwineHoleEe.th2
input SwineHoleE90.th2

map SwineHoleM -title "Swine Hole"
  SwineHoleSP1
  SwineHoleSP2
endmap

map SwineHoleME
  SwineHoleSE1
  SwineHoleSE2
endmap

map SwineHoleME90 -proj [elevation 90]
  SwineHoleSE90_1
  SwineHoleSE90_2
endmap
centreline

cs OSGB:ST
copyright 2012 "CC BY SA NC"

