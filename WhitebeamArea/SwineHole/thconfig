encoding  utf-8
source SwineHole.th
# Change name to the main therion file


#Surveys to output
#-----------------

#export map -proj plan -layout local -o SwineHole.pdf
#Produces plan of cave, on a single sheet

#export map -proj extended -layout local -o SwineHoleEe.pdf

export map -proj [elevation 90] -layout local -o SwineHoleE90.pdf

#export model -fmt survex -o SwineHoleth.3d
