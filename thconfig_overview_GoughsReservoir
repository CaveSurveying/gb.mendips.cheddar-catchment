encoding  utf-8
source CheddarCatchment.th
# Change name to the main therion file

#Surface.Charterhouse needs to be present for generation of 3d grid (comment out unselect)
#But unselected for lox, otherwise you get 2 grids
#unselect Surface.Charterhouse

select GoughsM@Goughs.CheddarCatchment
select allSumpsM@sumps.Goughs.CheddarCatchment
select WhiteSpotM@WhiteSpot.CheddarCatchment
select ReservoirM@Reservoir.CheddarCatchment
#select BrockM@Brock.WhitebeamArea.CheddarCatchment
select CoopersM@Coopers.CheddarCatchment
select Coxs@Coxs.CheddarCatchment
#select WhitebeamM@Whitebeam.WhitebeamArea.CheddarCatchment
#select SwineHoleM@SwineHole.WhitebeamArea.CheddarCatchment
#select Unknown1M@Unknown1.WhitebeamArea.CheddarCatchment



#Surveys to output
#-----------------

#Produces plan of cave, on a single sheet
export map -proj plan -layout local -o Outputs/Res_Goughs_overview.pdf


#export model -fmt survex -o OutputsRes_Goughs_overviewth.3d
#Survex file showing centre line only

#export model -o Outputs/Res_Goughs_overview.lox
#3d therion model to be viewed in the therion viewer


#export map -proj plan -fmt kml -layout mendip -o Outputs/Res_Goughs_overview.kml

layout local
copy common
#copy legend

surface bottom
surface-opacity 100
transparency off
#debug on
colour map-fg map

scale 1 4000

symbol-hide group all
symbol-show line wall

grid off
map-header 0 80 nw
map-header-bg off
statistics explo off
statistics topo off
statistics carto off
#symbol-color special north-arrow [0 100 100]
#symbol-colour special scale-bar [0 100 100]
scale-bar 500 m
legend-width 2 cm

code tex-map

\comment={\color[100 100 100]Base map data \copyright 2013 Google. Image \copyright 2013 Getmapping plc.}{}
#\legendtextcolor={\color[100 100 100]}
#\legendtitle{\color[100 100 100]Key}{}
  \legendwidth=10 cm
  
  \def\maplayout{
    \legendbox{60}{10}{nw}{ 
    \hsize=\legendwidth 
    \northarrow
     \bigskip
     \scalebar
  \bigskip
   \bigskip
 \the\comment
    }
   #  \legendbox{0}{0}{nw}{
   #  \the\comment
  # }
      \legendbox{0}{30}{sw}{
     \formattedlegend
    }
 }
endcode
endlayout

#get the master layout settings
input common_layout.th
