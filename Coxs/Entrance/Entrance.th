encoding  utf-8
survey Entrance

input Entrance.th2
#input EntranceEe.th2
input EntranceE90.th2

map EntranceM
  EntranceSP1
  EntranceSP2
endmap

#map EntranceME
 # EntranceSE1
#  EntranceSE2
#endmap

map EntranceME90 -proj [elevation 90]
  EntranceSE90_1
  EntranceSE90_2
endmap
centreline

