encoding  utf-8
survey Goughs

##############################################
#                                                                                                                             #
# Plan maps and joins                                                                                           #
#                                                                                                                             #
##############################################

#This map is used for putting all the cave together in the right
#places, used for overview and the like
map GoughsM -title "Gough's Cave"
    GoughsUpperM
    GoughsLowerM
    BeddingChamberM@BeddingChamber
    #Not sure why LLoydHallTopM is not in this????
endmap

#This map is to make a readable plan
#The thconfig file needs to also select GoughsUpperM
map GoughsDispM
    BeddingChamberBoxM@BeddingChamber
    BeddingChamberXM@BeddingChamber [-9 30 m] above
 #   GoughsUpperM
    GoughsLowerM [0 -80 m] below
    LLoydTopM [25 10 m] above
endmap

map LLoydTopM
  ImprobableXM@Improbable
  LloydHallTopM@LloydHall
endmap

map GoughsUpperM
  DSAvenM@DSAven
  BatRoomXM@BatRoom
  KingsSolomonsXM@KingsSolomons
  CastleHairyRingXM@CastleHairyRing
  BlackcatXM@Blackcat
  Damocles3M@Damocles3
  Damocles2M@Damocles2
  Damocles1M@Damocles1
  NathansAtticXM@NathansAttic
  DucksDelightXM@DucksDelight
  EntranceXM@Entrance
  FontsXM@Fonts 
  HeartbreakHillXM@HeartbreakHill
  TableauxM@Tableaux
  LloydHallBottomM@LloydHall
  TheOxbowXM@TheOxbow
  DireStraitsM@DireStraits
  StPaulsXM@StPauls
  NovemberXM@November
  SandChamberM@SandChamber
  SandCrawlXM@SandCrawl
  SideOxXM@SideOx
  HeartbreakDigXM@HeartbreakDig
  CheeseroomM@Cheeseroom
  WetWitchM@WetWitch
endmap

map GoughsLowerM
  FarRiftXM@FarRift
  CableCrawlM@CableCrawl
  NathansDungeonM@NathansDungeon
  Improbable2XM@Improbable2
  BoulderChamberXM@BoulderChamber
  TunnelXM@Tunnel  
endmap


#joins should be alphebetical, left to right, then top to bottom

join BatRoomSPl1@BatRoom EntranceSPl1@Entrance -smooth on
join BlackcatSPl1@Blackcat TableauxSPl1@Tableaux -smooth on
join BlackcatSPl2@Blackcat Damocles1SPl1@Damocles1 -smooth on
join BlackcatSPl2@Blackcat SandChamberSPl1@SandChamber -smooth on -count 3
join BlackcatSPl2@Blackcat SandCrawlSPl1@SandCrawl -smooth on


join BlackcatSPl2@Blackcat SandChamberSPl2@SandChamber -smooth on
join BlackcatSPl4@Blackcat TableauxSPl1@Tableaux -smooth on
join BoulderChamberSPl1@BoulderChamber FarRiftSPl1@FarRift -smooth on
join BoulderChamberSPl1@BoulderChamber FarRiftSPl2@FarRift -smooth on
join BoulderChamberSPl1@BoulderChamber Improbable2SPl1@Improbable2 -smooth on
join BoulderChamberSPl1@BoulderChamber SandChamberSPl3@SandChamber -smooth on

join CableCrawlSPl1@CableCrawl  Improbable2SPl1@Improbable2 -smooth on
join CableCrawlSPl1@CableCrawl TunnelSPl1@Tunnel -smooth on
join CheeseroomSPl1@Cheeseroom HeartbreakHillSPl1@HeartbreakHill  -smooth on
join CheeseroomSPl1@Cheeseroom TheOxbowSPl1@TheOxbow  -smooth on

join EntranceSPl1@Entrance FontsSPl1@Fonts -smooth on
join EntranceSPl1@Entrance HeartbreakHillSPl1@HeartbreakHill -smooth on
join EntranceSPl1@Entrance TheOxbowSPl1@TheOxbow -smooth on

join FarRiftSPl3@FarRift NathansDungeonSPl1@NathansDungeon -smooth on

join HeartbreakHillSPl1@HeartbreakHill HeartbreakDigSPl1@HeartbreakDig -smooth on
join HeartbreakHillSPl1@HeartbreakHill TunnelSPl1@Tunnel -smooth on

join ImprobableSPl1@Improbable LloydHallSPl1@LloydHall -smooth on
join ImprobableSPl1@Improbable TunnelSPl1@Tunnel -smooth on

#Order of the next group, for some reason, of joins is important to make it join correctly
join HeartbreakHillSPl1@HeartbreakHill TableauxSPl1@Tableaux -smooth on
join StPaulsSPl2@StPauls TableauxSPl1@Tableaux -smooth on 
join HeartbreakHillSPl1@HeartbreakHill StPaulsSPl1@StPauls -smooth on -count 3



join HeartbreakHillSPl1@HeartbreakHill TheOxbowSPl1@TheOxbow -smooth on

#join SandChamberSPl1@SandChamber Damocles1Sp1@Damocles1 -smooth on
#join Damocles1SPl30@Damocles1 Damocles2SPl1@Damocles2 -smooth on
join NovemberSPl2@November TableauxSPl1@Tableaux -smooth on
join TheOxbowSPl1@TheOxbow SideOxSPl1@SideOx -smooth on

join WetWitchSPl1@WetWitch StPaulsSPl1@StPauls -smooth on

##############################################
#                                                                                                                             #
# Projected elevation  maps and joins                                                                 #
#                                                                                                                             #
############################################## 

map NathansDungeon_allME0  -proj [elevation 0]
  NathansDungeonME0@NathansDungeon
  FarRiftME0_2@FarRift
endmap

map GoughsME0 -proj [elevation 0]
  FontsME0@Fonts 
  DSAvenME0@DSAven
  KingsSolomonsME0@KingsSolomons
  CastleHairyRingME0@CastleHairyRing
  BlackcatSouthME0@Blackcat
  BlackcatNorthME0@Blackcat
  NathansAtticME0@NathansAttic
  Damocles3ME0@Damocles3
  Damocles2ME0@Damocles2
  Damocles1ME0@Damocles1
  DucksDelightME0@DucksDelight
  EntranceME0@Entrance
  SkeletonME0@Skeleton
  BatRoomME0@BatRoom
  HeartbreakHillME0@HeartbreakHill
  TableauxME0@Tableaux
  TheOxbowME0@TheOxbow
  DireStraitsME0@DireStraits
  StPaulsME0@StPauls
  NovemberME0@November
  SandChamberME0@SandChamber
  SandCrawlME0@SandCrawl
  SideOxME0@SideOx
  HeartbreakDigME0@HeartbreakDig
  CheeseroomME0@Cheeseroom
  WetWitchME0@WetWitch
  CableCrawlME0@CableCrawl
  NathansDungeon_allME0
  Improbable2ME0@Improbable2
  ImprobableME0@Improbable
  LloydHallME0@LloydHall
  BoulderChamberME0@BoulderChamber
  FarRiftME0_1@FarRift
  TunnelME0@Tunnel
  BeddingChamberME0@BeddingChamber
  ShowCaveSumpsME0@sumps
endmap 

join roof1@BatRoom:0 roof1@Entrance:19 -smooth on
join roof1@Blackcat:2 roof1@CastleHairyRing:0 -smooth on
join roof2@Blackcat:end floor1@Blackcat:0 floor1@CastleHairyRing:0 -smooth on
join roof2@Blackcat:2 floor1@CastleHairyRing:end -smooth on
join roof3@Blackcat:4 roof1@CastleHairyRing:end -smooth on
join BlackcatSE0_1@Blackcat BoulderChamberSE0_1@BoulderChamber -smooth on
join BlackcatSE0_2@Blackcat KingsSolomonsSE0_1@KingsSolomons -smooth on
join BlackcatSE0_1@Blackcat NathansAtticSE0_1@NathansAttic -smooth on
join BlackcatSE0_1@Blackcat SandChamberSE0_2@SandChamber -smooth on
join roof5@Blackcat:4 roof1@SandCrawl:0 -smooth on
join floor3@Blackcat:4 floor1@SandCrawl:end -smooth on
join BlackcatSE0_2@Blackcat TableauxSE0_1@Tableaux -smooth on
join BeddingChamberSE0_1@BeddingChamber TableauxSE0_3@Tableaux -smooth on
join BoulderChamberSE0_1@BoulderChamber Improbable2SE0_1@Improbable2 -smooth on
join BoulderChamberSE0_1@BoulderChamber FarRiftSE0_2@FarRift -smooth on
join roof1@BoulderChamber:3 wall1@FarRift:end -smooth on
join pillar1@BoulderChamber:7 wall1@FarRift:0 -smooth on
join BoulderChamberSE0_1@BoulderChamber SandChamberSE0_2@SandChamber -smooth on

join CableCrawlSE0_1@CableCrawl Improbable2SE0_1@Improbable2 -smooth on
join CableCrawlSE0_1@CableCrawl NovemberSE0_1@November -smooth on
join CableCrawlSE0_1@CableCrawl TunnelSE0_1@Tunnel -smooth on
join CheeseroomSE0_1@Cheeseroom HeartbreakHillSE0_1@HeartbreakHill  -smooth on
join roof1@Cheeseroom:end roof1@TheOxbow:0 -smooth on
join floor1@Cheeseroom:0 roof2@TheOxbow:end -smooth on

join Damocles1SE0_2@Damocles1 Damocles2SE0_1@Damocles2 -smooth on
join wall1@Damocles2:1 wall1@Damocles3:0 -smooth on
join wall1@Damocles2:3 wall1@Damocles3:end -smooth on
join DireStraitsSE0_1@DireStraits  upstreamSE0_1@upstream.sumps -smooth on
join DucksDelightSE0_1@DucksDelight FontsSE0_1@Fonts -smooth on
join DucksDelightSE0_1@DucksDelight FontsSE0_2@Fonts -smooth on
join 1@DSAven:0 right1@TheOxbow:end -smooth on
join 1@DSAven:end left1@TheOxbow:0 -smooth on

join EntranceSE0_1@Entrance FontsSE0_2@Fonts -smooth on
join EntranceSE0_1@Entrance HeartbreakHillSE0_1@HeartbreakHill -smooth on

join FarRiftSE0_3@FarRift NathansDungeonSE0_1@NathansDungeon -smooth on
join FarRiftSE0_2@FarRift NathansAtticSE0_1@NathansAttic -smooth on

join HeartbreakHillSE0_1@HeartbreakHill HeartbreakDigSE0_1@HeartbreakDig -smooth on
join floor@HeartbreakHill:6 floor1@StPauls:0 -smooth on
join roof1@HeartbreakHill:3 floor1@StPauls:end -smooth on
join roof2@HeartbreakHill:21 floor2@StPauls:0 roof1@Tunnel:end -smooth on
join roof1@HeartbreakHill:9 roof@StPauls:end -smooth on
join roof2@HeartbreakHill:0 roof1@Tableaux:end -smooth on
join floor@HeartbreakHill:end floor1@Tableaux:0 -smooth on
#join roof2@HeartbreakHill:21 roof1@Tunnel:end -smooth on
join floor@HeartbreakHill:10 floor1@Tunnel:0  -smooth on
join HeartbreakHillSE0_1@HeartbreakHill TheOxbowSE0_1@TheOxbow -smooth on

join ImprobableSE0_1@Improbable Improbable2SE0_1@Improbable2 -smooth on
join roof1@Improbable:end roof1@LloydHall:10 -smooth on
join floor1@Improbable:0 floor1@LloydHall:3 -smooth on

join KingsSolomonsSE0_1@KingsSolomons TableauxSE0_2@Tableaux -smooth on

join upstreamSE0_1@upstream.sumps LloydHall1SE0_2@LloydHall -smooth on

join SideOxSE0_1@SideOx TheOxbowSE0_1@TheOxbow -smooth on
join StPaulsSE0_1@StPauls TableauxSE0_3@Tableaux -smooth on
join StPaulsSE0_2@StPauls TunnelSE0_1@Tunnel -smooth on



