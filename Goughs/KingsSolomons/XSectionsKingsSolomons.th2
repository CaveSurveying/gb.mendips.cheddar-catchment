encoding  utf-8
##XTHERION## xth_me_area_adjust 0 0 1600 1200
##XTHERION## xth_me_area_zoom_to 100

scrap XSectionSP -projection plan -scale [0 0 787.4 787.4 0 0 10 10 m]

point 0.0 0.0 station -name 6.10

point 240.0 240.0 section -scrap "KingsSolomonsSX6.14" -align t

point 240.0 100.0 label -text "ks1" -align c -scale s

point 720.0 240.0 section -scrap "KingsSolomonsSX6.11" -align t

point 720.0 100.0 label -text "ks2 " -align c -scale s

point 1200.0 240.0 section -scrap "KingsSolomonsSX6.8" -align t

point 1200.0 100.0 label -text "ks3" -align c -scale s

point 1713.5 240.0 section -scrap "KingsSolomonsSX6.4" -align t

point 1713.5 100.0 label -text "ks4" -align c -scale s

endscrap