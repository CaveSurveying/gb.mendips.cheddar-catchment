encoding  utf-8
##XTHERION## xth_me_area_adjust 0 0 1600 1200
##XTHERION## xth_me_area_zoom_to 100

scrap XSectionSP -projection plan -scale [0 0 787.4 787.4 0 0 10 10 m]

point 0.0 0.0 station -name 3.23

point 240.0 40.0 section -scrap "BoulderChamberSPX3.28" -align t

point 240.0 0.0 label -text "bo1" -align b -scale s

point 720.0 40.0 section -scrap "BoulderChamberSPX3.17" -align t

point 720.0 0.0 label -text "bo2" -align b -scale s

point 1200.0 40.0 section -scrap "BoulderChamberSPX3.13" -align t

point 1200.0 0.0 label -text "bo3" -align b -scale s

point 1680.0 40.0 section -scrap "BoulderChamberSPX3.11" -align t

point 1680.0 0.0 label -text "bo4" -align b -scale s

point 2160.0 40.0 section -scrap "BoulderChamberSPX3.5" -align t

point 2160.0 0.0 label -text "bo5" -align b -scale s

endscrap