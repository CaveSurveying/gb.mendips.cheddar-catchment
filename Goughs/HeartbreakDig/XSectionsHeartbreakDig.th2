encoding  utf-8
##XTHERION## xth_me_area_adjust 0 0 1600 1200
##XTHERION## xth_me_area_zoom_to 100

scrap XSectionSP -projection plan -scale [-128.0 -128.0 2726.42519685 -128.0 0.0 0.0 72.5024 0.0 m]

point 0.0 0.0 station -name 1.9

point 240.0 240.0 section -scrap "HeartbreakDigSX1.2" -align t

point 240.0 100.0 label -text "hd1" -align c -scale s

point 720.0 240.0 section -scrap "HeartbreakDigSX1.4" -align t

point 720.0 100.0 label -text "hd2" -align c -scale s

point 1200.0 240.0 section -scrap "HeartbreakDigSX1.5" -align t

point 1200.0 100.0 label -text "hd3" -align c -scale s

point 1680.0 240.0 section -scrap "HeartbreakDigSX1.8" -align t

point 1680.0 100.0 label -text "hd4" -align c -scale s

endscrap