encoding  utf-8
survey HeartbreakHill

input HeartbreakHill.th2
input HeartbreakHillE0.th2
input XSectionsHeartbreakHill.th2

map XSectionM
  XSectionSP
endmap

map HeartbreakHillXM
  XSectionM [-7700 -9220 cm] none
  HeartbreakHillM
endmap

map HeartbreakHillM
  HeartbreakHillSPl1
  #HeartbreakHillSPl2 removed as has magnetic distortion - redone with total station
endmap

map HeartbreakHillME0 -proj [elevation 0]
  HeartbreakHillSE0_1
endmap

