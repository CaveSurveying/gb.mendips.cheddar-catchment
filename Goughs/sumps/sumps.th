encoding  utf-8
survey sumps

input downstream/downstream.th
input upstream/upstream.th
input sump1b/sump1b.th
input bishops_palace/bishops_palace.th
input sump2/sump2.th
input sheppards_crook/sheppards_crook.th
input sump3/sump3

equate 20@downstream 20@upstream
equate 160@upstream 0@sump1b
equate 137@sump1b 0@bishops_palace
equate 19@bishops_palace 0@sump2
equate 23@sump2 1@sheppards_crook
equate 4@sheppards_crook 0_00@sump3

map sumpsM
  downstreamM@downstream
  upstreamM@upstream
  sump1bM@sump1b
  bishops_palaceM@bishops_palace 
  sump2M@sump2
  sheppards_crookM@sheppards_crook 
  sump3M@sump3
endmap

join downstreamSPl1@downstream upstreamSPl1@upstream -smooth on
join sump1bSPl1@sump1b bishops_palaceSPl1@bishops_palace -smooth on
join bishops_palaceSPl1@bishops_palace sump2SPl1@sump2 -smooth on
join sump2SPl1@sump2 sheppards_crookSPl1@sheppards_crook -smooth on
join sheppards_crookSPl1@sheppards_crook sump3SPl1@sump3 -smooth on

map sumpsME0 -proj [elevation 0]
  downstreamME0@downstream
  upstreamME0@upstream
  sump1bME0@sump1b
endmap

join downstreamSE0_1@downstream upstreamSE0_1@upstream -smooth on
join upstreamSE0_1@upstream sump1bSE0_1@sump1b -smooth on   

endsurvey

