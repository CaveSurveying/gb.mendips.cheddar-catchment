encoding  utf-8
source sumps.th
# Change name to the main therion file


#Surveys to output
#-----------------

#export map -proj plan -layout local -o sumps.pdf
#Produces plan of cave, on a single sheet

#export map -proj [elevation 0] -layout local -o sumpsE0.pdf

#export map -proj extended -layout local -o sumpsEe.pdf

select sump2plusE270M@sumps
export map -proj [elevation 270] -layout local -o sump2plusE270.pdf

select sump3plusE0M@sumps
export map -proj [elevation 0] -layout local -o sump3plusE0.pdf

#export model -fmt survex -o sumpsth.3d
#Survex file showing centre line only

#export model -o sumps.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o sumps_Walls.3d
#Survex file showing walls only

layout local

copy common
debug off
legend off
map-header 0 0 off
symbol-hide group centreline
colour map-fg [0 100 0]

grid-size 100 100 20 m
scale 1 500

code metapost

#####################################
#Text sizes
#xs: features such as sumps
#s: point names such as rocks
#m: normal names
#l: major names
#xl: Area/cave names
#####################################

  #base 1:750 scale 1:2750 (A3 charterhouse,GB)
  #fonts_setup(8,16,24,40,60)

  #scale 1:1000 (A0 width charterhouse,GB)
  #fonts_setup(7,10,14,20,30)

  #base 1:500 scale 1:2750 
  fonts_setup(8,20,26,40,60)

endcode 

endlayout

input ../../common_layout.th
