encoding  utf-8
##XTHERION## xth_me_area_adjust 0 0 1600 1200
##XTHERION## xth_me_area_zoom_to 100

scrap XSectionSP -projection plan -scale [0 0 787.5 787.5 0.0 0.0 10 10 m]

point 0.0 0.0 station -name 1.10

point 240.0 240.0 section -scrap "SandCrawlSX1.1" -align t

point 240.0 100.0 label -text "p1" -align c -scale s

point 720.0 240.0 section -scrap "SandCrawlSX1.2" -align t

point 720.0 100.0 label -text "p2" -align c -scale s

point 1200.0 240.0 section -scrap "SandCrawlSX1.4" -align t

point 1200.0 100.0 label -text "p3" -align c -scale s

point 1680.0 240.0 section -scrap "SandCrawlSX1.7" -align t

point 1680.0 100.0 label -text "p4" -align c -scale s

point 2160.0 240.0 section -scrap "SandCrawlSX1.8" -align t

point 2160.0 100.0 label -text "p5" -align c -scale s

endscrap