encoding  utf-8
survey SandCrawl

input SandCrawl.th2
input SandCrawlE0.th2
input XSectionsSandCrawl.th2

map XSectionM
  XSectionSP
endmap

map SandCrawlXM
  XSectionM [-102 -117 m] none
  SandCrawlM
endmap


map SandCrawlM
  SandCrawlSPl1
endmap

map SandCrawlME0 -proj [elevation 0]
  SandCrawlSE0_1
endmap

