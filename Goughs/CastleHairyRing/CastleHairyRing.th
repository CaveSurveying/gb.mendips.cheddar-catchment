encoding  utf-8
survey CastleHairyRing

input CastleHairyRing.th2
input CastleHairyRingE0.th2
input XSectionsCastleHairyRing.th2

map XSectionM
  XSectionSP
endmap

map CastleHairyRingXM
  XSectionM [-65 -40 m] none
  CastleHairyRingM
endmap

map CastleHairyRingM
  CastleHairyRingSPl1
endmap

map CastleHairyRingME0 -proj [elevation 0]
  CastleHairyRingSE0_1
endmap

centreline
  date 2011.10.24
  
  team "Andrew Atkinson" notes
  team "John Williams" instruments
  team "Graham Mullan" dog
  instrument instruments DistoX-UBSS1
  
  
  
  data normal from to compass clino tape
  extend right
