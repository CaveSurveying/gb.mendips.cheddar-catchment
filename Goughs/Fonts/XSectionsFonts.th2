encoding  utf-8
##XTHERION## xth_me_area_adjust 0 0 1600 1200
##XTHERION## xth_me_area_zoom_to 100

scrap XSectionSP -projection plan -scale [0 0 787.4 787.4 0 0 10 10 m]

point 0.0 0.0 station -name 1.2

point 240.0 440.0 section -scrap "FontsSPX1.34" -align t

point 240.0 200.0 label -text "e1" -align c -scale s

point 720.0 440.0 section -scrap "FontsSPX1.25" -align t

point 720.0 200.0 label -text "e2" -align c -scale s

point 1200.0 440.0 section -scrap "FontsSPX1.18" -align t

point 1200.0 200.0 label -text "e3" -align c -scale s

point 1680.0 440.0 section -scrap "FontsSPX1.13" -align t

point 1680.0 200.0 label -text "e4" -align c -scale s

point 2160.0 440.0 section -scrap "FontsSPX1.11" -align t

point 2160.0 200.0 label -text "e5" -align c -scale s

point 2640.0 440.0 section -scrap "FontsSPX1.7" -align t

point 2640.0 200.0 label -text "e6" -align c -scale s

point 3120.0 440.0 section -scrap "FontsSPX1.6" -align t

point 3120.0 200.0 label -text "e7" -align c -scale s

endscrap