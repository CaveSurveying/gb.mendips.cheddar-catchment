point 720.0 0.0 label -text "fo2" -align b -scale s

point 1200.0 40.0 section -scrap "FontsSPX1.18" -align t

point 1200.0 0.0 label -text "fo3" -align b -scale s

point 1680.0 40.0 section -scrap "FontsSPX1.13" -align t

point 1680.0 0.0 label -text "fo4" -align b -scale s

point 2160.0 40.0 section -scrap "FontsSPX1.11" -align t

point 2160.0 0.0 label -text "fo5" -align b -scale s

point 2640.0 40.0 section -scrap "FontsSPX1.7" -align t

point 2640.0 0.0 label -text "fo6" -align b -scale s

point 3120.0 40.0 section -scrap "FontsSPX1.6" -align t

point 3120.0 0.0 label -text "fo7" -align b -scale s

endscrap