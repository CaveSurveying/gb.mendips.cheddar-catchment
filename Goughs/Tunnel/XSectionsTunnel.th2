encoding  utf-8
##XTHERION## xth_me_area_adjust 0 0 1600 1200
##XTHERION## xth_me_area_zoom_to 100

scrap XSectionSP -projection plan -scale [0 0 787.4 787.4 0 0 10 10 m]

point 0.0 0.0 station -name 7.8

point 240.0 240.0 section -scrap "TunnelSX7.5" -align t

point 240.0 100.0 label -text "t1" -align c -scale s

point 720.0 240.0 section -scrap "TunnelSX7.1" -align t

point 720.0 100.0 label -text "t2" -align c -scale s

endscrap