encoding  utf-8
##XTHERION## xth_me_area_adjust 0 0 1600 1200
##XTHERION## xth_me_area_zoom_to 100

scrap XSectionSP -projection plan -scale [0 0 787.5 787.5 0.0 0.0 10 10 m]

point 0.0 0.0 station -name 9.17

point 240.0 240.0 section -scrap "FarRiftSX9.3" -align t

point 240.0 100.0 label -text "u1" -align c -scale s

point 720.0 240.0 section -scrap "FarRiftSX9.7" -align t

point 720.0 100.0 label -text "u2 " -align c -scale s

point 1200.0 240.0 section -scrap "FarRiftSX9.10" -align t

point 1200.0 100.0 label -text "u3" -align c -scale s

point 1680.0 240.0 section -scrap "FarRiftSX9.13" -align t

point 1680.0 100.0 label -text "u4 " -align c -scale s

endscrap