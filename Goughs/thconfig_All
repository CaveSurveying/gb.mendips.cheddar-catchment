 <br>\
 
colour map-fg map
colour-legend off
symbol-hide group centreline
grid-size 100 100 20 m
grid-coords border


#A1 (for plan)
scale 1 500


code tex-map
  \cavename={\size[70] Gough's Cave\medskip\size[40]Cheddar Gorge, Somerset.}
   # \cavelength={} %empty
   #\cavedepth={}  %empty
   \legendtextsize={\size[25]}
    \colorlegendfalse
    \legendwidth=30 cm


	

code metapost



