encoding  utf-8
survey DucksDelight

input DucksDelight.th2
input DucksDelightE0.th2
input XSectionsDucksDelight.th2

map XSectionM
  XSectionSP
endmap

map DucksDelightXM
  XSectionM [-80 -35 m] none
  DucksDelightM
endmap

map DucksDelightM
  DucksDelightSPl2
   break
  DucksDelightSPl1
endmap

map DucksDelightME0 -proj [elevation 0]
  DucksDelightSE0_1
endmap

centreline
