encoding  utf-8
##XTHERION## xth_me_area_adjust 0 0 1600 1200
##XTHERION## xth_me_area_zoom_to 100

scrap XSectionSP -projection plan -scale [0 0 787.5 787.5 0.0 0.0 10 10 m]

point 0.0 0.0 station -name 1.7

point 240.0 440.0 section -scrap "DucksDelightSX1.4" -align t

point 240.0 200.0 label -text "c1" -align c -scale s

point 720.0 440.0 section -scrap "DucksDelightSX1.8" -align t

point 720.0 200.0 label -text "c2" -align c -scale s

endscrap