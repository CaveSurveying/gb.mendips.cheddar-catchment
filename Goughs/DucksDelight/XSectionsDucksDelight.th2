encoding  utf-8
##XTHERION## xth_me_area_adjust 0 0 1600 1200
##XTHERION## xth_me_area_zoom_to 100

scrap XSectionSP -projection plan -scale [-128.0 -128.0 1309.1023622 -128.0 0.0 0.0 36.5023999999 0.0 m]

point 0.0 0.0 station -name 1.7

point 240.0 210.0 section -scrap "DucksDelightSX1.4" -align t

point 240.0 100.0 label -text "c1" -align c -scale s

point 720.0 210.0 section -scrap "DucksDelightSX1.8" -align t

point 720.0 100.0 label -text "c2" -align c -scale s

endscrap