encoding  utf-8
survey StPauls

input StPauls.th2
input StPaulsEe.th2
input StPaulsE0.th2
input XSectionsStPauls.th2

map XSectionM
  XSectionSP
endmap

map StPaulsXM
  XSectionM [-5400 -6780 cm] none
  StPaulsM
endmap

map StPaulsM
  StPaulsSPl1
  StPaulsSPl2
endmap

map StPaulsME
  StPaulsSEe1
endmap

map StPaulsME0 -proj [elevation 0]
  StPaulsSE0_1
  StPaulsSE0_2
endmap

