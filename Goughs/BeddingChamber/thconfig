encoding  utf-8
source BeddingChamber.th
# Change name to the main therion file


#Surveys to output
#-----------------

export map -proj plan -layout local -o BeddingChamber.pdf
#Produces plan of cave, on a single sheet

#export map -proj extended -layout local -o BeddingChamberEe.pdf

export model -fmt survex -o BeddingChamberth.3d
#Survex file showing centre line only

export model -o BeddingChamber.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o BeddingChamber_Walls.3d
#Survex file showing walls only

layout local
copy common
debug on
map-header 0 0 off
#symbol-hide group cave-centreline
endlayout

input ../../common_layout.th
