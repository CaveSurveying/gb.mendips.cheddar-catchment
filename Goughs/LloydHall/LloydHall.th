encoding  utf-8
survey LloydHall

input LloydHall.th2
input LloydHall1E0.th2
input LloydHall2E0.th2


map LloydHallTopM -proj plan
  LloydHallSPl1
 break
  LloydHallSPl2
endmap
 
map LloydHallBottomM -proj plan
  LloydHallSPl3
 break
  LloydHallSPl4
endmap

map LloydHallME0 -proj [elevation 0]
  LloydHall1SE0_1
  LloydHall1SE0_2
  LloydHall2SE0_1
  LloydHall2SE0_2
endmap

join LloydHall1SE0_2 LloydHall2SE0_1 -smooth on -count 2

equate 1.4 1.13
equate 8.3 1.5

centreline
#Divelink data stored in DiveLink.top
  date 2011.11.21

#DistoX UBSS2: Calab: 0.23
# John Williams and Duncan Price linking to dive line

  team "Duncan Price" notes
  team "John Williams" instruments
  instrument instruments UBSS2-distoX



data normal from to tape compass clino ignoreall
  extend right

