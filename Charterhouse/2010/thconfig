encoding  utf-8
source 2010.th
# Change name to the main therion file

select 2010M@2010 -map-level 1


#Surveys to output
#-----------------

export map -proj plan -layout local -o 2010.pdf
#Produces plan of cave, on a single sheet

#export map -proj extended -layout local -o 2010Ee.pdf

export model -fmt survex -o 2010th.3d
#Survex file showing centre line only

#export model  -o 2010.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o 2010_Walls.3d
#Survex file showing walls only

layout local
copy common
debug off
map-header 0 0 nw
colour map-fg map
legend off
colour-legend off

endlayout

input ../../common_layout.th
