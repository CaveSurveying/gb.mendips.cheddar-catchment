encoding  utf-8
survey TheDig

input TheDig.th2
input TheDigE90.th2
input TheDigEe.th2

map TheDigM
  TheDigSP1
 break
  TheDigSP2
 break
  TheDigSP3
 break
  TheDigSP4
endmap

map TheDigME90 -proj [elevation 90]
  TheDigSE90_1
  TheDigSE90_2
  TheDigSE90_3
  TheDigSE90_4
endmap

map TheDigMEe -proj [extended]
  TheDigSEe1
endmap
  
centreline

