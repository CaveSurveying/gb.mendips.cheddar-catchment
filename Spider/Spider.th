encoding  utf-8
survey Spider

input 4TonneShaft/4TonneShaft.th
input Entrance/Entrance.th
input Hazelnut/Hazelnut.th
input TheDig/TheDig.th

map SpiderM
  EntranceM@Entrance
 break
  HazelnutM@Hazelnut
  TheDigM@TheDig
endmap

map SpiderEeM
  EntranceEeM@Entrance
  HazelnutEeM@Hazelnut
  TheDigMEe@TheDig
endmap

equate 7.0@4TonneShaft 3.8@TheDig
equate 1.10@Entrance 2.0@Hazelnut
equate 2.9@Hazelnut 3.0@TheDig

#Plan joins
join EntranceSPl2@Entrance HazelnutSPl1@Hazelnut -smooth on


#Elevation joins
join HazelnutSEe1@Hazelnut TheDigSEe1@TheDig -smooth on

endsurvey

