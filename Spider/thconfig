encoding  utf-8
source Spider.th
# Change name to the main therion file


#Surveys to output
#-----------------

export map -proj plan -layout local -o Spider_No_tran.pdf
#Produces plan of cave, on a single sheet

export map -proj extended -layout local -o SpiderEe_No_tran.pdf

export model -fmt survex -o Spiderth.3d
#Survex file showing centre line only

#export model -o Spider.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o Spider_Walls.3d
#Survex file showing walls only

layout local
copy common
debug off
symbol-hide group centreline
map-header 0 0 ne

scale 1 200
transparency off
layers off

endlayout

input ../common_layout.th
